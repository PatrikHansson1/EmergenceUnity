00000000,"tick":n:40bec80000000000,"day":n:4074900000000000,"year":n:404b800000000000,"type":s:"child","txt":s:"👶 <b>Saga</b> and <b>Idun</b> have had a child, <b>Sixten</b> — generation 5. They inherit traits from both.","agent":n:4034000000000000,"x":n:402e075750748d33,"y":n:4043923a0258a8c7,"causes":[s:"agent:9",s:"agent:13",],},{"id":n:4076b00000000000,"tick":n:40bed40000000000,"day":n:4074a00000000000,"year":n:404b800000000000,"type":s:"season","txt":s:"❄️ Winter closes over the world. The stores will decide who sees spring.",},{"id":n:4076c00000000000,"tick":n:40bed50000000000,"day":n:4074a00000000000,"year":n:404b800000000000,"type":s:"star","txt":s:"📜✨ <b>Kare</b> pressed the pattern of the stars into clay — the first star-marks. Now the sky can be remembered.","agent":n:4028000000000000,},{"id":n:4076d00000000000,"tick":n:40bef80000000000,"day":n:4074b00000000000,"year":n:404c000000000000,"type":s:"field","txt":s:"🌱 <b>Sixten</b> has turned the soil — a new field lies open to the sky.","agent":n:4034000000000000,"x":n:402c000000000000,"y":n:4041800000000000,},{"id":n:4076e00000000000,"tick":n:40bf190000000000,"day":n:4074c00000000000,"year":n:404c000000000000,"type":s:"hoard","txt":s:"🏺 <b>Idun</b> has begun laying up stores beyond any need. The pile grows — and eyes have begun to follow it.","agent":n:402a000000000000,"x":n:4029314090149ea5,"y":n:40402778be73bc83,"causes":[s:"agent:13",],},{"id":n:4076f00000000000,"tick":n:40bf280000000000,"day":n:4074d00000000000,"year":n:404c000000000000,"type":s:"child","txt":s:"👶 <b>Halvar</b> and <b>Kare</b> have had a child, <b>Maja</b> — generation 4. They inherit traits from both.","agent":n:4035000000000000,"x":n:4055da0314cf6c60,"y":n:4044dc9172be30b1,"causes":[s:"agent:14",s:"agent:12",],},{"id":n:4077000000000000,"tick":n:40bf5c0000000000,"day":n:4074f00000000000,"year":n:404c000000000000,"type":s:"taught","txt":s:"<b>Bjorn</b> taught <b>Signe</b> the secret of Ask's gristmill. The knowledge spreads.","tech":s:"mill",},{"id":n:4077100000000000,"tick":n:40bf640000000000,"day":n:4075000000000000,"year":n:404c000000000000,"type":s:"season","txt":s:"❄️ Winter closes over the world. The stores will decide who sees spring.",},{"id":n:4077200000000000,"tick":n:40bf800000000000,"day":n:4075100000000000,"year":n:404c800000000000,"type":s:"season","txt":s:"🌸 Spring returns. The survivors count each other, and begin again.",},{"id":n:4077300000000000,"tick":n:40bf880000000000,"day":n:4075100000000000,"year":n:404c800000000000,"type":s:"field","txt":s:"🌱 <b>Maja</b> has turned the soil — a new field lies open to the sky.","agent":n:4035000000000000,"x":n:4052800000000000,"y":n:4042800000000000,},{"id":n:4077400000000000,"tick":n:40bf8e0000000000,"day":n:4075100000000000,"year":n:404c800000000000,"type":s:"taught","txt":s:"<b>Ylva</b> taught <b>Alve</b> the secret of Torv's melody. The knowledge spreads.","tech":s:"song",},{"id":n:4077500000000000,"tick":n:40bf8f0000000000,"day":n:4075100000000000,"year":n:404c800000000000,"type":s:"star","txt":s:"✨ <b>Signe</b> watches the stars again, night after night. Something is taking shape.","agent":n:402e000000000000,},{"id":n:4077600000000000,"tick":n:40bfcb0000000000,"day":n:4075400000000000,"year":n:404c800000000000,"type":s:"observed","txt":s:"👁️ <b>Ronja</b> noticed that stones grind seed to flour. An idea begins to form.","obs":s:"stonesGrind","agent":n:4033000000000000,"x":n:404a5e4695faa3e0,"y":n:404343c0ff40345e,},{"id":n:4077700000000000,"tick":n:40bfcf0000000000,"day":n:4075400000000000,"year":n:404c800000000000,"type":s:"failed","txt":s:"<b>Signe</b> tried something with stone and clay — and failed. But failure teaches.","agent":n:402e000000000000,},{"id":n:4077800000000000,"tick":n:40bfe20000000000,"day":n:4075500000000000,"year":n:404c800000000000,"type":s:"taught","txt":s:"<b>Bjorn</b> taught <b>Vidar</b> the secret of Eira's the library. The knowledge spreads.","tech":s:"scholarship",},{"id":n:4077900000000000,"tick":n:40bfe70000000000,"day":n:4075500000000000,"year":n:404c800000000000,"type":s:"failed","txt":s:"<b>Signe</b> tried something with stone and clay — and failed. But failure teaches.","agent":n:402e000000000000,},{"id":n:4077a00000000000,"tick":n:40bfeb0000000000,"day":n:4075500000000000,"year":n:404c800000000000,"type":s:"field","txt":s:"🌾 <b>Kare</b> brings in the harvest from Kare's field. Winter holds less fear now.","agent":n:4028000000000000,"x":n:4053c00000000000,"y":n:4040800000000000,},{"id":n:4077b00000000000,"tick":n:40bff40000000000,"day":n:4075600000000000,"year":n:404c800000000000,"type":s:"season","txt":s:"❄️ Winter closes over the world. The stores will decide who sees spring.",},{"id":n:4077c00000000000,"tick":n:40c0080000000000,"day":n:4075700000000000,"year":n:404d000000000000,"type":s:"quirk","txt":s:"🙂 <b>Liv</b> stops at the same strange stone every day, and looks at it. Once begun, never stopped.","agent":n:4014000000000000,"x":n:404b0ee42d8040b2,"y":n:40430d5dcf86ceea,},{"id":n:4077d00000000000,"tick":n:40c0280000000000,"day":n:4075900000000000,"year":n:404d000000000000,"type":s:"star","txt":s:"🌌 Under the Sky-Wheel, the people gather in the dark and turn their faces to the stars.","agent":n:4018000000000000,"x":n:4055a21b8d403783,"y":n:4035ff9bdc97b05a,},{"id":n:4077e00000000000,"tick":n:40c0290000000000,"day":n:4075a00000000000,"year":n:404d000000000000,"type":s:"star","txt":s:"✨ <b>Vidar</b> lay awake in the dark and watched the lights that do not fall.","agent":n:4030000000000000,"x":n:404ab6ff6fc0b047,"y":n:40442b9918326a41,},{"id":n:4077f00000000000,"tick":n:40c02b8000000000,"day":n:4075a00000000000,"year":n:404d000000000000,"type":s:"taught","txt":s:"<b>Bjorn</b> taught <b>Vidar</b> the secret of Eira's lenswork. The knowledge spreads.","tech":s:"glass",},{"id":n:4078000000000000,"tick":n:40c0380000000000,"day":n:4075b00000000000,"year":n:404d000000000000,"type":s:"taught","txt":s:"<b>Bjorn</b> taught <b>Vidar</b> the secret of Embla's written music. The knowledge spreads.","tech":s:"composition",},{"id":n:4078100000000000,"tick":n:40c03e0000000000,"day":n:4075b00000000000,"year":n:404d000000000000,"type":s:"taught","txt":s:"<b>Liv</b> taught <b>Ronja</b> the secret of Eira's pigmentwork. The knowledge spreads.","tech":s:"painting",},{"id":n:4078200000000000,"tick":n:40c0420000000000,"day":n:4075c00000000000,"year":n:404d000000000000,"type":s:"season","txt":s:"❄️ Winter closes over the world. The stores will decide who sees spring.",},{"id":n:4078300000000000,"tick":n:40c0500000000000,"day":n:4075d00000000000,"year":n:404d800000000000,"type":s:"quirk","txt":s:"🙂 <b>Ylva</b> walks the last few steps home backward. Always. Once begun, never stopped.","agent":n:401c000000000000,"x":n:4057762e4755c8b0,"y":n:4036a2cb7c9f4097,},{"id":n:4078400000000000,"tick":n:40c0578000000000,"day":n:4075d00000000000,"year":n:404d800000000000,"type":s:"taught","txt":s:"<b>Liv</b> taught <b>Ronja</b> the secret of Embla's plough. The knowledge spreads.","tech":s:"metaltools",},{"id":n:4078500000000000,"tick":n:40c05b8000000000,"day":n:4075e00000000000,"year":n:404d800000000000,"type":s:"hut","txt":s:"🛖 <b>Rune</b> built a hut.","x":n:404a0a540cc56188,"y":n:4040ca5c40c6385c,},{"id":n:4078600000000000,"tick":n:40c0638000000000,"day":n:4075e00000000000,"year":n:404d800000000000,"type":s:"star","txt":s:"✨ <b>Tuva</b> lay awake in the dark and watched the lights that do not fall.","agent":n:4031000000000000,"x":n:40551aea7ec160e0,"y":n:4037b762f246359a,},{"id":n:4078700000000000,"tick":n:40c0640000000000,"day":n:4075e00000000000,"year":n:404d800000000000,"type":s:"star","txt":s:"📜✨ <b>Signe</b> pressed the pattern of the stars into clay — the first star-marks. Now the sky can be remembered.","agent":n:402e000000000000,},{"id":n:4078800000000000,"tick":n:40c08a0000000000,"day":n:4076200000000000,"year":n:404d800000000000,"type":s:"season","txt":s:"❄️ Winter closes over the world. The stores will decide who sees spring.",},{"id":n:4078900000000000,"tick":n:40c08c8000000000,"day":n:4076200000000000,"year":n:404d800000000000,"type":s:"hut","txt":s:"🛖 <b>Idun</b> built a hut.","x":n:4034dd7d343411c5,"y":n:402df7cbb5fc5e56,},{"id":n:4078a00000000000,"tick":n:40c0980000000000,"day":n:4076300000000000,"year":n:404e000000000000,"type":s:"season","txt":s:"🌸 Spring returns. The survivors count each other, and begin again.",},{"id":n:4078b00000000000,"tick":n:40c0988000000000,"day":n:4076300000000000,"year":n:404e000000000000,"type":s:"death","txt":s:"<b>Eira the Rekindler</b> died of old age at 83. Much knowledge died with them — unless someone learned in time.","agent":n:3ff0000000000000,"x":n:404db23f69fb1307,"y":n:40437d2aa4ca9147,"cause":s:"age","causes":[s:"cause:age",],},{"id":n:4078c00000000000,"tick":n:40c0988000000000,"day":n:4076300000000000,"year":n:404e000000000000,"type":s:"knowledgeLost","txt":s:"🕯️ With <b>the last of them</b> died the last knowledge of Torv's the coin (Coinage). It is <b>extinct</b> — until someone rediscovers it.","tech":s:"coinage",},{"id":n:4078d00000000000,"tick":n:40c0990000000000,"day":n:4076300000000000,"year":n:404e000000000000,"type":s:"moved","txt":s:"<b>Bjorn</b> moved into an abandoned hut.",},{"id":n:4078e00000000000,"tick":n:40c0ad0000000000,"day":n:4076500000000000,"year":n:404e000000000000,"type":s:"star","txt":s:"✨ <b>Tuva</b> watches the stars again, night after night. Something is taking shape.","agent":n:4031000000000000,},{"id":n:4078f00000000000,"tick":n:40c0b50000000000,"day":n:4076500000000000,"year":n:404e000000000000,"type":s:"taught","txt":s:"<b>Alve</b> taught <b>Tuva</b> the secret of Torv's lodge. The knowledge spreads.","tech":s:"hut",},{"id":n:4079000000000000,"tick":n:40c0d20000000000,"day":n:4076800000000000,"year":n:404e000000000000,"type":s:"season","txt":s:"❄️ Winter closes over the world. The stores will decide who sees spring.",},],"dna":{"seed":n:41735276e0000000,"years":n:404e800000000000,"dna":{"Curious":n:4041000000000000,"Social":n:403e000000000000,"Diligent":n:4042000000000000,},"population":n:4032000000000000,"maxPop":n:4033000000000000,"generations":n:4014000000000000,"knowledgeCount":n:4048800000000000,"knowledgeMax":n:404a800000000000,"villages":[s:"Askheim",],"births":n:4031000000000000,"talks":n:4091bc0000000000,"deaths":{"starvation":n:3ff0000000000000,"cold":n:0000000000000000,"age":n:4000000000000000,"wolves":n:0000000000000000,},"knowledgeLosses":n:4010000000000000,"rediscoveries":n:4000000000000000,"failedExperiments":n:4069400000000000,"observations":n:4052c00000000000,"customsCount":n:4014000000000000,"traditions":[s:"The Knowing Eye",s:"the Sky-Wheel",s:"Painting a mark on a flat stone",s:"The Morning Whistle",],"taboos":[],"beliefs":[s:"The Knowing Eye",s:"the Sky-Wheel",],"conversions":n:4018000000000000,"hunts":n:3ff0000000000000,"harshWinters":n:4008000000000000,"reformations":n:0000000000000000,"worldview":s:"empiric","tabooBreaks":n:0000000000000000,"religions":[undef,],"legends":[s:"Torv Torv the Spearmaker.",s:"Ask Ask the Founder.",s:"Embla Embla the Rememberer.",s:"Eira Eira the Rekindler.",],"milestones":{"⚙️ Storytelling":s:"year 1","⚙️ Sharpened stone":s:"year 1","⚙️ Rope":s:"year 2","👶 First child":s:"year 2","⚙️ Weaving":s:"year 2","⚙️ Spear":s:"year 3","⚙️ Axe":s:"year 3","⚙️ Hut":s:"year 4","⚙️ The Wheel":s:"year 4","⚙️ Bow":s:"year 4","⚙️ Fire":s:"year 4","⚙️ Sailing":s:"year 5","🏘️ First village":s:"year 5","⚙️ Music":s:"year 6","⚙️ Pottery":s:"year 6","⚙️ Farming":s:"year 6","⚙️ Kiln":s:"year 8","⚙️ Counting":s:"year 8","⚙️ Mill":s:"year 8","⚙️ Calendar":s:"year 9","⚙️ Fishing":s:"year 9","⚙️ Writing":s:"year 9","⚙️ Granary":s:"year 9","⚙️ Brick":s:"year 10","⚙️ Tin":s:"year 10","⚙️ Well":s:"year 10","⚙️ Masonry":s:"year 12","⚙️ Road":s:"year 12","⚙️ Architecture":s:"year 12","⚙️ Aqueduct":s:"year 13","⚙️ Windmill":s:"year 13","⚙️ Painting":s:"year 14","⚙️ Philosophy":s:"year 14","⚙️ Medicine":s:"year 14","⚙️ Composition":s:"year 14","⚙️ Iron smithing":s:"year 16","⚙️ Metal tools":s:"year 16","🌿 First tradition":s:"year 18","⚙️ Law":s:"year 19","⚙️ School":s:"year 19","⚙️ Temple":s:"year 19","⚙️ Scholarship":s:"year 20","⚙️ University":s:"year 21","⚙️ Coinage":s:"year 21","⚙️ Coal":s:"year 23","⚙️ Glass":s:"year 25","⚙️ Glassblowing":s:"year 26","⚙️ Copper":s:"year 30","⚙️ Bronze":s:"year 31","⚙️ Steel":s:"year 33","⚙️ Optics":s:"year 34","⚙️ Science":s:"year 36",},"status":s:"Alive in year 61","violence":{"steals":n:0000000000000000,"raids":n:0000000000000000,"feuds":n:0000000000000000,"killings":n:0000000000000000,"brawls":n:0000000000000000,"wars":n:0000000000000000,},"trades":n:404f800000000000,"gifts":n:4022000000000000,"leaders":[],"giftWays":[],"wealthTop":s:"Ylva (82)",},"history":{"worldName":s:"Askheim","seed":n:41735276e0000000,"years":n:404e800000000000,"intro":s:"This is the chronicle of Askheim - 61 years, 5 generations, written by no one. Every line below happened.","outro":s:"The chronicle is still being written. 18 souls carry it onward.","chapters":[{"title":s:"The Waking","from":n:3ff0000000000000,"to":n:403e000000000000,"text":[s:"🌍 Four humans wake in an untouched world: Eira, Ask, Embla, Torv. They know nothing — but they can observe everything. What will they create?",s:"It was in the year 1, when Eira told the day back as a story worth remembering. Eira's oral saga entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 1, when Eira struck two stones together and kept the sharp shard. Eira's knife entered the world, and nothing was quite the same after.",s:"It was in the year 2, when Torv twisted grass fibers into something strong. Torv's braid entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 2, when Torv crossed threads over threads until cloth grew on the frame. Torv's the loom entered the world, and nothing was quite the same after.",s:"It was in the year 3, when Torv lashed a sharp point to a long shaft. Torv's pike entered the world, and nothing was quite the same after.",s:"In the year 3, when Torv bound a hard edge to a wooden shaft. Torv's hewer entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 4, when Torv raised logs against each other into a shelter. Torv's lodge entered the world, and nothing was quite the same after.",s:"In the year 4, when Torv watched a log roll and understood something great. Torv's pulley entered the world, and nothing was quite the same after.",s:"In the year 4, when Torv bent a young branch with a cord and felt it fight back. Torv's hunting bow entered the world, and nothing was quite the same after.",s:"It was in the year 4, when Torv rubbed sticks together until a spark caught the tinder. Torv's blaze entered the world, and nothing was quite the same after.",s:"It was in the year 5, when Torv stretched cloth on a hull and let the wind do the work. Torv's river-craft entered the world, and nothing was quite the same after.",s:"It was in the year 6, when Torv found that a struck string and a voice could ring together. Torv's melody entered the world, and nothing was quite the same after.",s:"It was in the year 6, when Embla placed shaped clay in the fire and found it hard as stone. Embla's urn entered the world, and nothing was quite the same after.",s:"It was in the year 6, when Embla pressed spilled seeds into turned soil and waited. Embla's tilling entered the world, and nothing was quite the same after.",s:"It was in the year 8, when Ask built a stone chamber that gathered the heat of the fire. Ask's hearth entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 8, when Torv matched pebble to sheep and found number itself. Torv's the count entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 8, when Ask let the wheel drive stones that ground grain. Ask's gristmill entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 9, when Torv counted the stars and seasons into a fixed wheel of days. Torv's the year-wheel entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 9, when Embla let a twisted line sink where the fish gather. Embla's hookline entered the world, and nothing was quite the same after.",s:"In the year 9, when Embla carved signs into clay so knowledge could outlive its owner. Embla's glyphs entered the world, and nothing was quite the same after.",s:"It was in the year 9, when Embla built a dry raised store so the harvest kept till spring. Embla's silo entered the world, and nothing was quite the same after.",s:"It was in the year 10, when Embla fired shaped clay into blocks that stack true. Embla's mudbrick entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 10, when Torv smelted a pale metal too soft to be worth much alone. Torv's white metal entered the world, and nothing was quite the same after.",s:"It was in the year 10, when Eira lined a deep pit with stone to hold clean water. Eira's stone well entered the world, and nothing was quite the same after.",s:"In the year 12, when Eira dressed and fitted stone so it stood without mortar. Eira's stonecraft entered the world, and nothing was quite the same after.",s:"In the year 12, when Eira laid stone in a bed so carts ran true in any weather. Eira's trackway entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 12, when Eira raised the arch, and space opened under stone. Eira's the arch entered the world, and nothing was quite the same after.",s:"It was in the year 13, when Eira carried water across the valley on arches of stone. Eira's conduit entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 13, when Eira set great sails to catch the wind and turn the stones. Eira's tower-mill entered the world, and nothing was quite the same after.",s:"It was in the year 14, when Eira ground coloured earth and left an image on the wall. Eira's pigmentwork entered the world, and nothing was quite the same after.",s:"In the year 14, when Embla asked not what the world is but why, and wrote it down. Embla's the argument entered the world, and nothing was quite the same after.",s:"In the year 14, when Eira learned which leaves ease pain and close a wound. Eira's the healer entered the world, and nothing was quite the same after.",s:"In the year 14, when Embla wrote music down so a song could outlive its singer. Embla's written music entered the world, and nothing was quite the same after.",s:"In the year 16, when Embla watched gleaming metal run from the glowing ore. Embla's ironcraft entered the world, and nothing was quite the same after.",s:"It was in the year 16, when Embla forged the iron into an edge that never dulled. Embla's plough entered the world, and nothing was quite the same after.",s:"It was in the year 19, when Eira wrote the customs down so all were judged by one measure. Eira's the code entered the world, and nothing was quite the same after.",s:"In the year 19, when Eira set the knowing to teach the young in one place. Eira's the school entered the world, and nothing was quite the same after.",s:"In the year 19, when Eira raised a house for the sacred and gathered the faithful in it. Eira's the temple entered the world, and nothing was quite the same after.",s:"It was in the year 20, when Eira gathered writings and studied them as a life's work. Eira's the library entered the world, and nothing was quite the same after.",s:"In the year 21, when Eira joined scholars and students into a lasting house of learning. Eira's the academy entered the world, and nothing was quite the same after.",s:"In the year 21, when Torv stamped a fixed weight of metal all agreed to trust. Torv's the coin entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 23, when Liv found the black stone burns hotter than any wood. Liv's black-stone fire entered the world, and nothing was quite the same after.",s:"It was in the year 25, when Eira melted sand and found something transparent. Eira's lenswork entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 26, when Eira blew molten sand into clear vessels thin as a bubble. Eira's clearware entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 30, when Sten coaxed a soft red metal out of green stone in the kiln. Sten's the soft metal entered the world, and nothing was quite the same after.",s:"In the year 5, three huts grew into more, and Askheim was founded - a place with a name, which is the beginning of belonging.",s:"By the year 18, believing the world repeats and can be understood had become simply what one does in Askheim. No one decided this.",s:"By the year 28, believing a great herd walks the night sky, and the living must follow its path had become simply what one does in Askheim. It merely became true.",s:"Then came a quieter grief: in the year 9, Eira the Rekindler — the last soul who understood mill — died, and the knowledge went dark.",s:"Yet in the year 9 it returned - mill, rediscovered, as if the world refused to forget forever.",s:"In the year 1, Eira began seeing the world differently - believing the world repeats and can be understood. Where others saw spirits, they saw patterns.",s:"In the year 2, Torv began seeing the world differently - believing a great herd walks the night sky, and the living must follow its path. Where others saw patterns, they felt a will behind them.",s:"The winter of year 25 was a hard one. Food ran thin, the cold pressed close, and the fires were fed like gods.",s:"From that day on, Torv was known as Torv the Spearmaker.",s:"From that day on, Ask was known as Ask the Founder.",s:"From that day on, Embla was known as Embla the Rememberer.",s:"From that day on, Eira was known as Eira the Rekindler.",s:"And in those same years, Sten picks a flower every spring and puts it somewhere no one sees. Once begun, never stopped.",s:"And when the food ran low, those who kept the same ways fed one another. The rituals, whatever the skeptics said, kept people alive.",s:"Through it all 6 children were born under its skies and 1 lives ended - 1 to hunger.",],},{"title":s:"The Hunger Winter","from":n:403f000000000000,"to":n:404e000000000000,"text":[s:"It was in the year 31, when Sten poured copper and tin together and woke a hard new metal. Sten's the hard alloy entered the world, and nothing was quite the same after.",s:"In the year 33, when Torv worked iron in a coal-hot fire until it took a keener soul. Torv's tempered blade entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 34, when Liv ground clear glass until it bent light to the eye. Liv's the lens entered the world, and nothing was quite the same after.",s:"It was in the year 36, when Liv tested the guess against the world and kept only what held. Liv's experiment entered the world, and nothing was quite the same after.",s:"By the year 47, painting a mark on a flat stone when something new is made had become simply what one does in Askheim. No council voted.",s:"By the year 47, whistling to greet the morning had become simply what one does in Askheim. It merely became true.",s:"Then came a quieter grief: in the year 36, the last soul who understood coinage died, and the knowledge went dark.",s:"Then came a quieter grief: in the year 36, the last soul who understood coinage died, and the knowledge went dark.",s:"Then came a quieter grief: in the year 36, Torv the Spearmaker — the last soul who understood steel — died, and the knowledge went dark.",s:"Then came a quieter grief: in the year 60, the last soul who understood coinage died, and the knowledge went dark.",s:"Yet in the year 36 it returned - coinage, rediscovered, as if the world refused to forget forever.",s:"The winter of year 40 was a hard one. Food ran thin, the cold pressed close, and the fires were fed like gods.",s:"The winter of year 52 was a hard one. Food ran thin, the cold pressed close, and the fires were fed like gods.",s:"The spear fed the people: hunters brought down deer when the bushes stood bare, and the winters lost some of their terror.",s:"The chronicle notes, without explanation, that Liv stops at the same strange stone every day, and looks at it. Once begun, never stopped.",s:"And when the food ran low, those who kept the same ways fed one another. The rituals, whatever the skeptics said, kept people alive.",s:"In these years 11 children were born under its skies and 2 lives ended - 2 to age.",],},],},"endState":{"tick":n:40c0e00000000000,"hour":n:4018000000000000,"day":n:4076900000000000,"season":s:"spring","ended":false,"endedYear":undef,"maxPop":n:4033000000000000,"nextId":n:4036000000000000,"nextCustomId":n:4018000000000000,"nextAnimalId":n:4052c00000000000,"maxGeneration":n:4014000000000000,"usedNames":n:4035000000000000,"winterSeverity":n:3fec825455800000,"seenWinter":true,"brewing":null,"stats":{"talks":n:4091bc0000000000,"births":n:4031000000000000,"deaths":{"starvation":n:3ff0000000000000,"cold":n:0000000000000000,"age":n:4000000000000000,"wolves":n:0000000000000000,},"failedExperiments":n:4069400000000000,"observations":n:4052c00000000000,"conversions":n:4018000000000000,"hunts":n:3ff0000000000000,"harshWinters":n:4008000000000000,"trades":n:404f800000000000,"gifts":n:4022000000000000,"harvests":n:4024000000000000,},"traitSum":{"curiosity":n:4025a766e613499a,"social":n:4023341c64f58fff,"diligence":n:402747925cf63e68,"n":n:4035000000000000,},"agents":[{"id":n:4008000000000000,"name":s:"Embla","x":n:4038dab4d76ce241,"y":n:402115263ab9ea8d,"age":n:4053800000000000,"gen":n:3ff0000000000000,"lifespan":n:4055000000000000,"hunger":n:4059c0000000057f,"energy":n:4054000000000000,"warmth":n:4053570a2792fffb,"social":n:4058b33333333334,"inv":{"wood":n:40200000000000