014000000000000,"traditions":[s:"The Knowing Eye",s:"the Sky-Wheel",s:"The Morning Whistle",],"taboos":[],"beliefs":[s:"The Knowing Eye",s:"the Sky-Wheel",],"conversions":n:4024000000000000,"hunts":n:4000000000000000,"harshWinters":n:4008000000000000,"reformations":n:0000000000000000,"worldview":s:"empiric","tabooBreaks":n:0000000000000000,"religions":[undef,],"legends":[s:"Torv Torv the Spearmaker.",s:"Ask Ask the Founder.",s:"Embla Embla the Rememberer.",s:"Eira Eira the Rekindler.",],"milestones":{"⚙️ Storytelling":s:"year 1","⚙️ Sharpened stone":s:"year 1","⚙️ Rope":s:"year 2","👶 First child":s:"year 2","⚙️ Weaving":s:"year 2","⚙️ Spear":s:"year 3","⚙️ Axe":s:"year 3","⚙️ Hut":s:"year 4","⚙️ The Wheel":s:"year 4","⚙️ Bow":s:"year 4","⚙️ Fire":s:"year 4","⚙️ Sailing":s:"year 5","🏘️ First village":s:"year 5","⚙️ Music":s:"year 6","⚙️ Pottery":s:"year 6","⚙️ Farming":s:"year 6","⚙️ Kiln":s:"year 8","⚙️ Counting":s:"year 8","⚙️ Mill":s:"year 8","⚙️ Calendar":s:"year 9","⚙️ Fishing":s:"year 9","⚙️ Writing":s:"year 9","⚙️ Granary":s:"year 9","⚙️ Brick":s:"year 10","⚙️ Tin":s:"year 10","⚙️ Well":s:"year 10","⚙️ Masonry":s:"year 12","⚙️ Road":s:"year 12","⚙️ Architecture":s:"year 12","⚙️ Aqueduct":s:"year 13","⚙️ Windmill":s:"year 13","⚙️ Painting":s:"year 14","⚙️ Philosophy":s:"year 14","⚙️ Medicine":s:"year 14","⚙️ Composition":s:"year 14","⚙️ Iron smithing":s:"year 16","⚙️ Metal tools":s:"year 16","🌿 First tradition":s:"year 18","⚙️ Law":s:"year 19","⚙️ School":s:"year 19","⚙️ Temple":s:"year 19","⚙️ Scholarship":s:"year 20","⚙️ University":s:"year 21","⚙️ Coinage":s:"year 21","⚙️ Coal":s:"year 23","⚙️ Glass":s:"year 25","⚙️ Glassblowing":s:"year 26","⚙️ Copper":s:"year 30","⚙️ Bronze":s:"year 31","⚙️ Bronze tools":s:"year 32","⚙️ Mechanical clock":s:"year 32","⚙️ Optics":s:"year 35","⚙️ Printing press":s:"year 37","⚙️ Science":s:"year 47",},"status":s:"Alive in year 61","violence":{"steals":n:0000000000000000,"raids":n:0000000000000000,"feuds":n:0000000000000000,"killings":n:0000000000000000,"brawls":n:0000000000000000,"wars":n:0000000000000000,},"trades":n:4052400000000000,"gifts":n:4010000000000000,"leaders":[s:"Askheim: Embla",],"giftWays":[],"wealthTop":s:"Embla the Rememberer (145)",},"history":{"worldName":s:"Askheim","seed":n:41735276e0000000,"years":n:404e800000000000,"intro":s:"This is the chronicle of Askheim - 61 years, 4 generations, written by no one. Every line below happened.","outro":s:"The chronicle is still being written. 14 souls carry it onward.","chapters":[{"title":s:"The Waking","from":n:3ff0000000000000,"to":n:403e000000000000,"text":[s:"🌍 Four humans wake in an untouched world: Eira, Ask, Embla, Torv. They know nothing — but they can observe everything. What will they create?",s:"It was in the year 1, when Eira told the day back as a story worth remembering. Eira's oral saga entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 1, when Eira struck two stones together and kept the sharp shard. Eira's knife entered the world, and nothing was quite the same after.",s:"It was in the year 2, when Torv twisted grass fibers into something strong. Torv's braid entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 2, when Torv crossed threads over threads until cloth grew on the frame. Torv's the loom entered the world, and nothing was quite the same after.",s:"It was in the year 3, when Torv lashed a sharp point to a long shaft. Torv's pike entered the world, and nothing was quite the same after.",s:"In the year 3, when Torv bound a hard edge to a wooden shaft. Torv's hewer entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 4, when Torv raised logs against each other into a shelter. Torv's lodge entered the world, and nothing was quite the same after.",s:"In the year 4, when Torv watched a log roll and understood something great. Torv's pulley entered the world, and nothing was quite the same after.",s:"In the year 4, when Torv bent a young branch with a cord and felt it fight back. Torv's hunting bow entered the world, and nothing was quite the same after.",s:"It was in the year 4, when Torv rubbed sticks together until a spark caught the tinder. Torv's blaze entered the world, and nothing was quite the same after.",s:"It was in the year 5, when Torv stretched cloth on a hull and let the wind do the work. Torv's river-craft entered the world, and nothing was quite the same after.",s:"It was in the year 6, when Torv found that a struck string and a voice could ring together. Torv's melody entered the world, and nothing was quite the same after.",s:"It was in the year 6, when Embla placed shaped clay in the fire and found it hard as stone. Embla's urn entered the world, and nothing was quite the same after.",s:"It was in the year 6, when Embla pressed spilled seeds into turned soil and waited. Embla's tilling entered the world, and nothing was quite the same after.",s:"It was in the year 8, when Ask built a stone chamber that gathered the heat of the fire. Ask's hearth entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 8, when Torv matched pebble to sheep and found number itself. Torv's the count entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 8, when Ask let the wheel drive stones that ground grain. Ask's gristmill entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 9, when Torv counted the stars and seasons into a fixed wheel of days. Torv's the year-wheel entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 9, when Embla let a twisted line sink where the fish gather. Embla's hookline entered the world, and nothing was quite the same after.",s:"In the year 9, when Embla carved signs into clay so knowledge could outlive its owner. Embla's glyphs entered the world, and nothing was quite the same after.",s:"It was in the year 9, when Embla built a dry raised store so the harvest kept till spring. Embla's silo entered the world, and nothing was quite the same after.",s:"It was in the year 10, when Embla fired shaped clay into blocks that stack true. Embla's mudbrick entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 10, when Torv smelted a pale metal too soft to be worth much alone. Torv's white metal entered the world, and nothing was quite the same after.",s:"It was in the year 10, when Eira lined a deep pit with stone to hold clean water. Eira's stone well entered the world, and nothing was quite the same after.",s:"In the year 12, when Eira dressed and fitted stone so it stood without mortar. Eira's stonecraft entered the world, and nothing was quite the same after.",s:"In the year 12, when Eira laid stone in a bed so carts ran true in any weather. Eira's trackway entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 12, when Eira raised the arch, and space opened under stone. Eira's the arch entered the world, and nothing was quite the same after.",s:"It was in the year 13, when Eira carried water across the valley on arches of stone. Eira's conduit entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 13, when Eira set great sails to catch the wind and turn the stones. Eira's tower-mill entered the world, and nothing was quite the same after.",s:"It was in the year 14, when Eira ground coloured earth and left an image on the wall. Eira's pigmentwork entered the world, and nothing was quite the same after.",s:"In the year 14, when Embla asked not what the world is but why, and wrote it down. Embla's the argument entered the world, and nothing was quite the same after.",s:"In the year 14, when Eira learned which leaves ease pain and close a wound. Eira's the healer entered the world, and nothing was quite the same after.",s:"In the year 14, when Embla wrote music down so a song could outlive its singer. Embla's written music entered the world, and nothing was quite the same after.",s:"In the year 16, when Embla watched gleaming metal run from the glowing ore. Embla's ironcraft entered the world, and nothing was quite the same after.",s:"It was in the year 16, when Embla forged the iron into an edge that never dulled. Embla's plough entered the world, and nothing was quite the same after.",s:"It was in the year 19, when Eira wrote the customs down so all were judged by one measure. Eira's the code entered the world, and nothing was quite the same after.",s:"In the year 19, when Eira set the knowing to teach the young in one place. Eira's the school entered the world, and nothing was quite the same after.",s:"In the year 19, when Eira raised a house for the sacred and gathered the faithful in it. Eira's the temple entered the world, and nothing was quite the same after.",s:"It was in the year 20, when Eira gathered writings and studied them as a life's work. Eira's the library entered the world, and nothing was quite the same after.",s:"In the year 21, when Eira joined scholars and students into a lasting house of learning. Eira's the academy entered the world, and nothing was quite the same after.",s:"In the year 21, when Torv stamped a fixed weight of metal all agreed to trust. Torv's the coin entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 23, when Liv found the black stone burns hotter than any wood. Liv's black-stone fire entered the world, and nothing was quite the same after.",s:"It was in the year 25, when Eira melted sand and found something transparent. Eira's lenswork entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 26, when Eira blew molten sand into clear vessels thin as a bubble. Eira's clearware entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 30, when Sten coaxed a soft red metal out of green stone in the kiln. Sten's the soft metal entered the world, and nothing was quite the same after.",s:"In the year 5, three huts grew into more, and Askheim was founded - a place with a name, which is the beginning of belonging.",s:"By the year 18, believing the world repeats and can be understood had become simply what one does in Askheim. No one decided this.",s:"By the year 28, believing a great herd walks the night sky, and the living must follow its path had become simply what one does in Askheim. It merely became true.",s:"Then came a quieter grief: in the year 9, Eira the Rekindler — the last soul who understood mill — died, and the knowledge went dark.",s:"Yet in the year 9 it returned - mill, rediscovered, as if the world refused to forget forever.",s:"In the year 1, Eira began seeing the world differently - believing the world repeats and can be understood. Where others saw spirits, they saw patterns.",s:"In the year 2, Torv began seeing the world differently - believing a great herd walks the night sky, and the living must follow its path. Where others saw patterns, they felt a will behind them.",s:"The winter of year 25 was a hard one. Food ran thin, the cold pressed close, and the fires were fed like gods.",s:"From that day on, Torv was known as Torv the Spearmaker.",s:"From that day on, Ask was known as Ask the Founder.",s:"From that day on, Embla was known as Embla the Rememberer.",s:"From that day on, Eira was known as Eira the Rekindler.",s:"And in those same years, Sten picks a flower every spring and puts it somewhere no one sees. Once begun, never stopped.",s:"And when the food ran low, those who kept the same ways fed one another. The rituals, whatever the skeptics said, kept people alive.",s:"Through it all 6 children were born under its skies and 1 lives ended - 1 to hunger.",],},{"title":s:"The Hunger Winter","from":n:403f000000000000,"to":n:404e000000000000,"text":[s:"It was in the year 31, when Sten poured copper and tin together and woke a hard new metal. Sten's the hard alloy entered the world, and nothing was quite the same after.",s:"In the year 32, when Sten cast bronze into edges that held far longer than stone. Sten's castings entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 32, when Sten tamed a falling weight into steady, counted time. Sten's the clockwork entered the world, and nothing was quite the same after.",s:"It was in the year 35, when Ylva ground clear glass until it bent light to the eye. Ylva's the glass eye entered the world, and nothing was quite the same after.",s:"It was in the year 37, when Sten set movable letters and pressed a page in a heartbeat. Sten's the press entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 47, when Ylva tested the guess against the world and kept only what held. Ylva's the method entered the world, and nothing was quite the same after.",s:"By the year 58, whistling to greet the morning had become simply what one does in Askheim. No council voted.",s:"Then came a quieter grief: in the year 34, the last soul who understood coinage died, and the knowledge went dark.",s:"Then came a quieter grief: in the year 36, the last soul who understood coinage died, and the knowledge went dark.",s:"Yet in the year 36 it returned - coinage, rediscovered, as if the world refused to forget forever.",s:"The winter of year 38 was a hard one. Food ran thin, the cold pressed close, and the fires were fed like gods.",s:"The winter of year 53 was a hard one. Food ran thin, the cold pressed close, and the fires were fed like gods.",s:"The spear fed the people: hunters brought down deer when the bushes stood bare, and the winters lost some of their terror.",s:"The chronicle notes, without explanation, that Saga walks the last few steps home backward. Always. Once begun, never stopped.",s:"In Askheim, the people have begun to listen when Embla the Rememberer speaks — prestige has hardened into leadership. No one voted; it is simply so.",s:"One soul, that age, quietly left an old way for a new one.",s:"Meanwhile 7 children were born under its skies and 2 lives ended - 2 to age.",],},],},"endState":{"tick":n:40c0e00000000000,"hour":n:4018000000000000,"day":n:4076900000000000,"season":s:"spring","ended":false,"endedYear":undef,"maxPop":n:402e000000000000,"nextId":n:4032000000000000,"nextCustomId":n:4018000000000000,"nextAnimalId":n:4056800000000000,"maxGeneration":n:4010000000000000,"usedNames":n:4031000000000000,"winterSeverity":n:3feb5b33cbeccccd,"seenWinter":true,"brewing":null,"stats":{"talks":n:408de80000000000,"births":n:402a000000000000,"deaths":{"starvation":n:3ff0000000000000,"cold":n:0000000000000000,"age":n:4000000000000000,"wolves":n:0000000000000000,},"failedExperiments":n:406e800000000000,"observations":n:4050800000000000,"conversions":n:4024000000000000,"hunts":n:4000000000000000,"harshWinters":n:4008000000000000,"trades":n:4052400000000000,"gifts":n:4010000000000000,"harvests":n:4010000000000000,"leaders":n:3ff0000000000000,},"traitSum":{"curiosity":n:40201ed53cf38ccd,"social":n:401e91ff63bc1999,"diligence":n:4023356b09eb1333,"n":n:4031000000000000,},"agents":[{"id":n:4008000000000000,"name":s:"Embla","x":n:4051b8430917893a,"y":n:404073d774d6a1de,"age":n:4053800000000000,"gen":n:3ff0000000000000,"lifespan":n:4055000000000000,"hunger":n:4058c00000000568,"energy":n:4030000000000000,"warmth":n:4057d11ad464d1e2,"social":n:4058533333333335,"inv":{"wood":n:403e000000000000,"clay":n:4046800000000000,"fiber":n:4042800000000000,"stone":n:4036000000000000,"pigment":n:3ff0000000000000,"iron":n:3ff0000000000000,"tin":n:3ff0000000000000,"gold":n:3ff0000000000000,"coal":n:3ff0000000000000,"sand":n:4008000000000000,"copper":n:4008000000000000,"bronze":n:0000000000000000,},"knows":Set[s:"storytelling",s:"sharp",s:"rope",s:"spear",s:"axe",s:"hut",s:"fire",s:"pottery",s:"bow",s:"farming",s:"kiln",s:"fishing",s:"writing",s:"granary",s:"brick",s:"weaving",s:"well",s:"tin",s:"sailing",s:"wheel",s:"song",s:"philosophy",s:"composition",s:"smithing",s:"metaltools",s:"masonry",s:"medicine",s:"road",s:"architecture",s:"numbers",s:"aqueduct",s:"painting",s:"calendar",s:"law",s:"mill",s:"scholarship",s:"school",s:"windmill",s:"temple",s:"university",s:"glass",s:"glassblowing",s:"coal",s:"bronze",s:"copper",s:"bronzetools",s:"printpress",s:"clock",s:"optics",s:"science",],"obs":Set[s:"branchBends",s:"sharpShards",s:"starsWheel",s:"fibersTwist",s:"seedsSprout",s:"frictionHeat",s:"soundsRing",s:"marksRemain",s:"heatHardens",s:"fishGather",s:"bronzeHard",s:"logsRoll",s:"oreMelts",s:"herbsHeal",s:"archStands",s:"pigmentStains",s:"stonesGrind",s:"weightsBalance",s:"sandGlints",s:"goldGleams",s:"coalBurns",s:"copperGreen",s:"lensBends",],"customs":Set[s:"c1",s:"c2",s:"c4",],"rel":{"5":n:4077f00000000000,"6":n:408a380000000000,"7":n:406b400000000000,"8":n:4082300000000000,"9":n:4041000000000000,"10":n:4063800000000000,"11":n:405a400000000000,"12":n:4052c00000000000,"14":n:4046000000000000,},"task":s:"wandering","expT":n:0000000000000000,"expTech":null,"expAlt":null,"say":s:"Have you ever counted the stars?","sayT":n:4041000000000000,"sayAct":s:"observe","inspired":n:0000000000000000,"childCd":n:0000000000000000,"talkCd":n:4030000000000000,"phase":n:3fd33947e787ae15,"hue":n:4060200000000000,"traits":{"curiosity":n:3fdd83bc348ccccd,"social":n:3fd350cb664ccccd,"diligence":n:3fdee84bcef66666,"conformity":n:3fe8b77867cccccd,"dexterity":n:3fe5fdef8fb33333,"creativity":n:3fc1c5603199999a,"musicality":n:3fe94e91a0199999,"empathy":n:3fea2a3b98fb3333,"ambition":n:3fe50b35e48e6666,"aggression":n:3fe46bc28c580000,"impulse":n:3fe92c7794666666,"vindictiveness":n:3fec3855a3766667,},"grudges":{},"parents":null,"habit":null,"habitShown":false,"habitOrigin":null,"born":n:c032000000000000,"_vil":{"x":n:404a595bb1c37453,"y":n:4044c82c75bceefb,"name":s:"Askheim","everHeld":Set[s:"storytelling",s:"sharp",s:"rope",s:"spear",s:"axe",s:"hut",s:"fire",s:"weaving",s:"wheel",s:"bow",s:"sailing",s:"pottery",s:"farming",s:"song",s:"kiln",s:"mill",s:"numbers",s:"fishing",s:"writing",s:"granary",s:"calendar",s:"brick",s:"well",s:"tin",s:"masonry",s:"road",s:"architecture",s:"aqueduct",s:"windmill",s:"painting",s:"medicine",s:"philosophy",s:"composition",s:"smithing",s:"metaltools",s:"law",s:"school",s:"temple",s:"scholarship",s:"university",s:"coinage",s:"coal",s:"glass",s:"glassblowing",s:"copper",s:"bronze",s:"bronzetools",s:"clock",s:"optics",s:"printpress",s:"science",],"lostNow":Set[s:"coinage",],"_mem":[<cycle>,{"id":n:4014000000000000,"name":s:"Liv","x":n:4051744ef7169c79,"y":n:4040aaee6fa09b31,"age":n:404d380000000000,"gen":n:4000000000000000,"lifespan":n:4052c00000000000,"hunger":n:4059f99999999eaa,"energy":n:4042200000000000,"warmth":n:4057707f5448fd6f,"social":n:4058400000000002,"inv":{"wood":n:402c000000000000,"fiber":n:402c000000000000,"stone":n:402e000000000000,"clay":n:402e000000000000,"tin":n:3ff0000000000000,"pigment":n:4000000000000000,"iron":n:4000000000000000,"coal":n:4014000000000000,"gold":n:0000000000000000,"sand":n:4014000000000000,"copper":n:4008000000000000,"bronze":n:0000000000000000,},"knows":Set[s:"storytelling",s:"sharp",s:"spear",s:"rope",s:"fire",s:"axe",s:"pottery",s:"farming",s:"kiln",s:"well",s:"song",s:"hut",s:"wheel",s:"bow",s:"mill",s:"writing",s:"brick",s:"granary",s:"weaving",s:"calendar",s:"tin",s:"sailing",s:"masonry",s:"road",s:"architecture",s:"aqueduct",s:"numbers",s:"painting",s:"smithing",s:"metaltools",s:"coal",s:"windmill",s:"medicine",s:"law",s:"philosophy",s:"school",s:"temple",s:"scholarship",s:"composition",s:"university",s:"fishing",s:"glass",s:"glassblowing",s:"clock",s:"copper",s:"bronze",s:"bronzetools",s:"printpress",],"obs":Set[s:"logsRoll",s:"sharpShards",s:"starsWheel",s:"fibersTwist",s:"branchBends",s:"frictionHeat",s:"archStands",s:"seedsSprout",s:"herbsHeal",s:"pigmentStains",s:"heatHardens",s:"marksRemain",s:"stonesGrind",s:"soundsRing",s:"weightsBalance",s:"bronz