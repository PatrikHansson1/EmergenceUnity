{"meta":{"seed":n:41735276e0000000,"ticksRequested":n:40c0e00000000000,"founders":null,"engine":s:"emergence-engine.js","engineVersion":s:"2.6.0",},"events":[{"id":n:0000000000000000,"tick":n:0000000000000000,"day":n:3ff0000000000000,"year":n:3ff0000000000000,"type":s:"start","txt":s:"🌍 Four humans wake in an untouched world: <b>Eira</b>, <b>Ask</b>, <b>Embla</b>, <b>Torv</b>. They know nothing — but they can observe everything. What will they create?",},{"id":n:3ff0000000000000,"tick":n:401c000000000000,"day":n:3ff0000000000000,"year":n:3ff0000000000000,"type":s:"failed","txt":s:"<b>Embla</b> tried something with  — and failed. But failure teaches.","agent":n:4008000000000000,},{"id":n:4000000000000000,"tick":n:4022000000000000,"day":n:3ff0000000000000,"year":n:3ff0000000000000,"type":s:"tech","txt":s:"📖 <b>Eira</b> told the day back as a story worth remembering — <b>Eira's oral saga</b> (Storytelling) has been invented! <i>The first culture — memory shaped into meaning.</i>","tech":s:"storytelling","agent":n:3ff0000000000000,"x":n:40495ebcda313333,"y":n:4042a9742343cccd,"causes":[],},{"id":n:4008000000000000,"tick":n:4022000000000000,"day":n:3ff0000000000000,"year":n:3ff0000000000000,"type":s:"custom","txt":s:"🌿 <b>Eira</b> began believing the world repeats and can be understood — no one told them to. Others may follow. <i>(The Knowing Eye)</i>","custom":s:"c1","agent":n:3ff0000000000000,"x":n:40495ebcda313333,"y":n:4042a9742343cccd,"label":s:"A NEW WAY OF SEEING",},{"id":n:4010000000000000,"tick":n:4045800000000000,"day":n:4008000000000000,"year":n:3ff0000000000000,"type":s:"star","txt":s:"✨ <b>Eira</b> lay awake in the dark and watched the lights that do not fall.","agent":n:3ff0000000000000,"x":n:40490168f4de3125,"y":n:40437de9d69641f9,},{"id":n:4014000000000000,"tick":n:4045800000000000,"day":n:4008000000000000,"year":n:3ff0000000000000,"type":s:"star","txt":s:"✨ <b>Ask</b> lay awake in the dark and watched the lights that do not fall.","agent":n:4000000000000000,"x":n:4048ebace4d366dd,"y":n:404756aeb41688c4,},{"id":n:4018000000000000,"tick":n:4046000000000000,"day":n:4008000000000000,"year":n:3ff0000000000000,"type":s:"tech","txt":s:"🔪 <b>Eira</b> struck two stones together and kept the sharp shard — <b>Eira's knife</b> (Sharpened stone) has been invented! <i>Faster gathering of everything.</i>","tech":s:"sharp","agent":n:3ff0000000000000,"x":n:40490168f4de3125,"y":n:40437de9d69641f9,"causes":[],},{"id":n:401c000000000000,"tick":n:4056800000000000,"day":n:4014000000000000,"year":n:3ff0000000000000,"type":s:"star","txt":s:"✨ <b>Eira</b> watches the stars again, night after night. Something is taking shape.","agent":n:3ff0000000000000,},{"id":n:4020000000000000,"tick":n:405d000000000000,"day":n:4018000000000000,"year":n:3ff0000000000000,"type":s:"season","txt":s:"❄️ The first winter has come. The world turns white and hard, and the nights grow long. Fire is no longer comfort — it is life.",},{"id":n:4022000000000000,"tick":n:4061200000000000,"day":n:4018000000000000,"year":n:3ff0000000000000,"type":s:"star","txt":s:"✨ <b>Embla</b> lay awake in the dark and watched the lights that do not fall.","agent":n:4008000000000000,"x":n:4049e9ff6dd1c77e,"y":n:4042f4f892f3c137,},{"id":n:4024000000000000,"tick":n:4064400000000000,"day":n:4020000000000000,"year":n:4000000000000000,"type":s:"star","txt":s:"✨ <b>Torv</b> lay awake in the dark and watched the lights that do not fall.","agent":n:4010000000000000,"x":n:404ea1e41db6e5d0,"y":n:4037b9f7266633b6,},{"id":n:4026000000000000,"tick":n:4067e00000000000,"day":n:4022000000000000,"year":n:4000000000000000,"type":s:"tech","txt":s:"🪢 <b>Torv</b> twisted grass fibers into something strong — <b>Torv's braid</b> (Rope) has been invented! <i>Makes it possible to bind parts together.</i>","tech":s:"rope","agent":n:4010000000000000,"x":n:404daadd9b837f6a,"y":n:40363eabbd7033b5,"causes":[],},{"id":n:4028000000000000,"tick":n:406c200000000000,"day":n:4024000000000000,"year":n:4000000000000000,"type":s:"taught","txt":s:"<b>Eira</b> taught <b>Ask</b> the secret of Eira's knife. The knowledge spreads.","tech":s:"sharp",},{"id":n:402a000000000000,"tick":n:406c200000000000,"day":n:4024000000000000,"year":n:4000000000000000,"type":s:"child","txt":s:"👶 <b>Eira</b> and <b>Ask</b> have had a child, <b>Liv</b> — generation 2. They inherit traits from both.","agent":n:4014000000000000,"x":n:404743801e5ce882,"y":n:40436f6dd5ae5e02,"causes":[s:"agent:1",s:"agent:2",],},{"id":n:402c000000000000,"tick":n:4070400000000000,"day":n:4028000000000000,"year":n:4000000000000000,"type":s:"season","txt":s:"❄️ Winter closes over the world. The stores will decide who sees spring.",},{"id":n:402e000000000000,"tick":n:4070900000000000,"day":n:4028000000000000,"year":n:4000000000000000,"type":s:"tech","txt":s:"🧶 <b>Torv</b> crossed threads over threads until cloth grew on the frame — <b>Torv's the loom</b> (Weaving) has been invented! <i>Cloth for warmth and trade — and hands that specialize.</i>","tech":s:"weaving","agent":n:4010000000000000,"x":n:404b82073ad465ef,"y":n:40377fbdd99dcdda,"causes":[s:"ev:11",],},{"id":n:4030000000000000,"tick":n:4071800000000000,"day":n:4028000000000000,"year":n:4000000000000000,"type":s:"star","txt":s:"✨ <b>Ask</b> watches the stars again, night after night. Something is taking shape.","agent":n:4000000000000000,},{"id":n:4031000000000000,"tick":n:4071b00000000000,"day":n:402a000000000000,"year":n:4000000000000000,"type":s:"custom","txt":s:"🌿 <b>Torv</b> began believing a great herd walks the night sky, and the living must follow its path — no one told them to. Others may follow. <i>(the Sky-Wheel)</i>","custom":s:"c2","agent":n:4010000000000000,"x":n:4049a3449f25f3d8,"y":n:403e28f29c0a827e,"label":s:"A NEW WAY OF SEEING",},{"id":n:4032000000000000,"tick":n:4071b00000000000,"day":n:402a000000000000,"year":n:4000000000000000,"type":s:"star","txt":s:"🌌 <b>Torv</b> saw a pattern in the stars and gave it a name — <b>the Sky-Wheel</b>. From watching, a cosmology is born: the first faith of the sky.","agent":n:4010000000000000,"label":s:"A RELIGION OF THE SKY",},{"id":n:4033000000000000,"tick":n:4072000000000000,"day":n:402a000000000000,"year":n:4008000000000000,"type":s:"season","txt":s:"🌸 Spring returns. The survivors count each other, and begin again.",},{"id":n:4034000000000000,"tick":n:4074800000000000,"day":n:402c000000000000,"year":n:4008000000000000,"type":s:"star","txt":s:"✨ <b>Embla</b> watches the stars again, night after night. Something is taking shape.","agent":n:4008000000000000,},{"id":n:4035000000000000,"tick":n:4078a00000000000,"day":n:4031000000000000,"year":n:4008000000000000,"type":s:"failed","txt":s:"<b>Torv</b> tried something with wood and stone and fiber — and failed. But failure teaches.","agent":n:4010000000000000,},{"id":n:4036000000000000,"tick":n:4079100000000000,"day":n:4031000000000000,"year":n:4008000000000000,"type":s:"tech","txt":s:"🗡️ <b>Torv</b> lashed a sharp point to a long shaft — <b>Torv's pike</b> (Spear) has been invented! <i>Humans are prey no longer. Deer can be hunted — food even in winter.</i>","tech":s:"spear","agent":n:4010000000000000,"x":n:404808ed4c28bcad,"y":n:40434ed13133361a,"causes":[s:"ev:6",s:"ev:11",],},{"id":n:4037000000000000,"tick":n:4079100000000000,"day":n:4031000000000000,"year":n:4008000000000000,"type":s:"epithet","txt":s:"✨ From that day on, <b>Torv</b> was known as <b>Torv the Spearmaker</b>.","agent":n:4010000000000000,"x":n:404808ed4c28bcad,"y":n:40434ed13133361a,},{"id":n:4038000000000000,"tick":n:4079400000000000,"day":n:4032000000000000,"year":n:4008000000000000,"type":s:"season","txt":s:"❄️ Winter closes over the world. The stores will decide who sees spring.",},{"id":n:4039000000000000,"tick":n:407aa00000000000,"day":n:4033000000000000,"year":n:4008000000000000,"type":s:"tech","txt":s:"🪓 <b>Torv</b> bound a hard edge to a wooden shaft — <b>Torv's hewer</b> (Axe) has been invented! <i>Twice as fast logging. Required to build huts.</i>","tech":s:"axe","agent":n:4010000000000000,"x":n:40477164bf5abcad,"y":n:4042eaf99f913619,"causes":[s:"ev:6",s:"ev:11",],},{"id":n:403a000000000000,"tick":n:407bc00000000000,"day":n:4033000000000000,"year":n:4010000000000000,"type":s:"observed","txt":s:"👁️ <b>Liv</b> noticed that grass fibers hold when twisted. An idea begins to form.","obs":s:"fibersTwist","agent":n:4014000000000000,"x":n:4049c6678cb23294,"y":n:4044721962521301,},{"id":n:403b000000000000,"tick":n:407ea00000000000,"day":n:4035000000000000,"year":n:4010000000000000,"type":s:"hoard","txt":s:"🏺 <b>Ask</b> has begun laying up stores beyond any need. The pile grows — and eyes have begun to follow it.","agent":n:4000000000000000,"x":n:4048dbb78d95966a,"y":n:4044c3d077816582,"causes":[s:"agent:2",],},{"id":n:403c000000000000,"tick":n:407fe00000000000,"day":n:4036000000000000,"year":n:4010000000000000,"type":s:"tech","txt":s:"🛖 <b>Torv</b> raised logs against each other into a shelter — <b>Torv's lodge</b> (Hut) has been invented! <i>Shelter and warmth at night. Three huts close together become a village.</i>","tech":s:"hut","agent":n:4010000000000000,"x":n:40480d5e6e2eefe1,"y":n:40440bbfe67d3618,"causes":[s:"ev:25",],},{"id":n:403d000000000000,"tick":n:4080700000000000,"day":n:4037000000000000,"year":n:4010000000000000,"type":s:"child","txt":s:"👶 <b>Embla</b> and <b>Torv</b> have had a child, <b>Sten</b> — generation 2. They inherit traits from both.","agent":n:4018000000000000,"x":n:4048eeb2720b54bc,"y":n:404470b6a5a725c8,"causes":[s:"agent:3",s:"agent:4",],},{"id":n:403e000000000000,"tick":n:4080780000000000,"day":n:4037000000000000,"year":n:4010000000000000,"type":s:"tech","txt":s:"🛞 <b>Torv</b> watched a log roll and understood something great — <b>Torv's pulley</b> (The Wheel) has been invented! <i>The foundation of mills, carts — and everything that spins.</i>","tech":s:"wheel","agent":n:4010000000000000,"x":n:4047d1b39829bcae,"y":n:40444459166e02e5,"causes":[s:"ev:25",],},{"id":n:403f000000000000,"tick":n:4080b80000000000,"day":n:4037000000000000,"year":n:4010000000000000,"type":s:"failed","txt":s:"<b>Ask</b> tried something with stone and wood and fiber — and failed. But failure teaches.","agent":n:4000000000000000,},{"id":n:4040000000000000,"tick":n:4080c80000000000,"day":n:4037000000000000,"year":n:4010000000000000,"type":s:"tech","txt":s:"🏹 <b>Torv</b> bent a young branch with a cord and felt it fight back — <b>Torv's hunting bow</b> (Bow) has been invented! <i>The hunt no longer needs closeness. Deer fall at a distance.</i>","tech":s:"bow","agent":n:4010000000000000,"x":n:40483c50af552314,"y":n:40447966cfd03618,"causes":[s:"ev:22",s:"ev:11",],},{"id":n:4040800000000000,"tick":n:4081100000000000,"day":n:4038000000000000,"year":n:4010000000000000,"type":s:"hoard","txt":s:"🏺 <b>Torv the Spearmaker</b> has begun laying up stores beyond any need. The pile grows — and eyes have begun to follow it.","agent":n:4010000000000000,"x":n:404812450186cdc9,"y":n:40448be66cfe87f1,"causes":[s:"agent:4",],},{"id":n:4041000000000000,"tick":n:4081200000000000,"day":n:4038000000000000,"year":n:4010000000000000,"type":s:"season","txt":s:"❄️ Winter closes over the world. The stores will decide who sees spring.",},{"id":n:4041800000000000,"tick":n:4081700000000000,"day":n:4038000000000000,"year":n:4010000000000000,"type":s:"tech","txt":s:"🔥 <b>Torv</b> rubbed sticks together until a spark caught the tinder — <b>Torv's blaze</b> (Fire) has been invented! <i>Warmth at night. Opens the path to pottery and smithing.</i>","tech":s:"fire","agent":n:4010000000000000,"x":n:40485284fdfb6762,"y":n:404577f7f426ee57,"causes":[],},{"id":n:4042000000000000,"tick":n:4082000000000000,"day":n:4039000000000000,"year":n:4014000000000000,"type":s:"tech","txt":s:"⛵ <b>Torv</b> stretched cloth on a hull and let the wind do the work — <b>Torv's river-craft</b> (Sailing) has been invented! <i>Rivers and coasts become roads — trade and migration by water.</i>","tech":s:"sailing","agent":n:4010000000000000,"x":n:4047fbcd4e55342d,"y":n:404548f9f52c87f3,"causes":[s:"ev:15",s:"ev:25",],},{"id":n:4042800000000000,"tick":n:4082000000000000,"day":n:4039000000000000,"year":n:4014000000000000,"type":s:"season","txt":s:"🌸 Spring returns. The survivors count each other, and begin again.",},{"id":n:4043000000000000,"tick":n:4082100000000000,"day":n:4039000000000000,"year":n:4014000000000000,"type":s:"failed","txt":s:"<b>Embla</b> tried something with wood and fiber — and failed. But failure teaches.","agent":n:4008000000000000,},{"id":n:4043800000000000,"tick":n:4082380000000000,"day":n:4039000000000000,"year":n:4014000000000000,"type":s:"hut","txt":s:"🛖 <b>Torv</b> built a hut.","x":n:4047e6fadd396760,"y":n:404539b8c268bb26,},{"id":n:4044000000000000,"tick":n:4082700000000000,"day":n:4039000000000000,"year":n:4014000000000000,"type":s:"hut","txt":s:"🛖 <b>Embla</b> built a hut.","x":n:4049be5fd370b3cf,"y":n:4044dfef0fabe460,},{"id":n:4044800000000000,"tick":n:4083000000000000,"day":n:403a000000000000,"year":n:4014000000000000,"type":s:"observed","txt":s:"👁️ <b>Embla</b> noticed that fire makes clay hard. An idea begins to form.","obs":s:"heatHardens","agent":n:4008000000000000,"x":n:4049c36a8b61e703,"y":n:4045765bf4007dfa,},{"id":n:4045000000000000,"tick":n:4083080000000000,"day":n:403a000000000000,"year":n:4014000000000000,"type":s:"hut","txt":s:"🛖 <b>Ask</b> built a hut.","x":n:404a595bb1c37453,"y":n:4044c82c75bceefb,},{"id":n:4045800000000000,"tick":n:4083080000000000,"day":n:403a000000000000,"year":n:4014000000000000,"type":s:"epithet","txt":s:"✨ From that day on, <b>Ask</b> was known as <b>Ask the Founder</b>.","agent":n:4000000000000000,"x":n:404a595bb1c37453,"y":n:4044c82c75bceefb,},{"id":n:4046000000000000,"tick":n:4083080000000000,"day":n:403a000000000000,"year":n:4014000000000000,"type":s:"village","txt":s:"🏘️ Three huts have become more — <b>Askheim</b> has been founded! A village born of nothing but cooperation.","village":s:"Askheim","x":n:404a595bb1c37453,"y":n:4044c82c75bceefb,"causes":[s:"agent:2",],},{"id":n:4046800000000000,"tick":n:4085a00000000000,"day":n:403e000000000000,"year":n:4014000000000000,"type":s:"season","txt":s:"❄️ Winter closes over the world. The stores will decide who sees spring.",},{"id":n:4047000000000000,"tick":n:4086580000000000,"day":n:403f000000000000,"year":n:4014000000000000,"type":s:"failed","txt":s:"<b>Embla</b> tried something with wood and fiber — and failed. But failure teaches.","agent":n:4008000000000000,},{"id":n:4047800000000000,"tick":n:4087f80000000000,"day":n:4040800000000000,"year":n:4018000000000000,"type":s:"tech","txt":s:"🎵 <b>Torv</b> found that a struck string and a voice could ring together — <b>Torv's melody</b> (Music) has been invented! <i>Song at the fire — the root of every art to come.</i>","tech":s:"song","agent":n:4010000000000000,"x":n:4047bb8daf24fc99,"y":n:4043b5b773bac5a6,"causes":[s:"ev:2",],},{"id":n:4048000000000000,"tick":n:4088180000000000,"day":n:4040800000000000,"year":n:4018000000000000,"type":s:"observed","txt":s:"👁️ <b>Eira</b> noticed that grass fibers hold when twisted. An idea begins to form.","obs":s:"fibersTwist","agent":n:3ff0000000000000,"x":n:4049d6f588734748,"y":n:4045d6a7254d9824,},{"id":n:4048800000000000,"tick":n:4088400000000000,"day":n:4040800000000000,"year":n:4018000000000000,"type":s:"tech","txt":s:"🏺 <b>Embla</b> placed shaped clay in the fire and found it hard as stone — <b>Embla's urn</b> (Pottery) has been invented! <i>Food can be stored — hunger bites less.</i>","tech":s:"pottery","agent":n:4008000000000000,"x":n:404b78012fa3a78b,"y":n:4046ddca9844feb5,"causes":[s:"ev:35",],},{"id":n:4049000000000000,"tick":n:4088680000000000,"day":n:4040800000000000,"year":n:4018000000000000,"type":s:"taught","txt":s:"<b>Ask</b> taught <b>Eira</b> the secret of Torv's hewer. The knowledge spreads.","tech":s:"axe",},{"id":n:4049800000000000,"tick":n:4089200000000000,"day":n:4041000000000000,"year":n:4018000000000000,"type":s:"observed","txt":s:"👁️ <b>Eira</b> noticed that rubbing wood makes heat. An idea begins to form.","obs":s:"frictionHeat","agent":n:3ff0000000000000,"x":n:404a87b291f37a7b,"y":n:40454284691464f1,},{"id":n:404a000000000000,"tick":n:4089280000000000,"day":n:4041000000000000,"year":n:4018000000000000,"type":s:"failed","txt":s:"<b>Eira</b> tried something with wood and stone and fiber — and failed. But failure teaches.","agent":n:3ff0000000000000,},{"id":n:404a800000000000,"tick":n:4089300000000000,"day":n:4041000000000000,"year":n:4018000000000000,"type":s:"taught","txt":s:"<b>Torv</b> taught <b>Ask</b> the secret of Torv's hunting bow. The knowledge spreads.","tech":s:"bow",},{"id":n:404b000000000000,"tick":n:4089480000000000,"day":n:4041000000000000,"year":n:4018000000000000,"type":s:"hoard","txt":s:"🏺 <b>Embla</b> has begun laying up stores beyond any need. The pile grows — and eyes have begun to follow it.","agent":n:4008000000000000,"x":n:404b27572a55f804,"y":n:4047db71ae35828c,"causes":[s:"agent:3",],},{"id":n:404b800000000000,"tick":n:4089980000000000,"day":n:4041800000000000,"year":n:4018000000000000,"type":s:"failed","txt":s:"<b>Eira</b> tried something with wood and stone and fiber — and failed. But failure teaches.","agent":n:3ff0000000000000,},{"id":n:404c000000000000,"tick":n:408a100000000000,"day":n:4042000000000000,"year":n:4018000000000000,"type":s:"tech","txt":s:"🌱 <b>Embla</b> pressed spilled seeds into turned soil and waited — <b>Embla's tilling</b> (Farming) has been invented! <i>Food that returns every year. The village roots itself.</i>","tech":s:"farming","agent":n:4008000000000000,"x":n:404aecd792051466,"y":n:404953b26f83ef89,"causes":[s:"ev:49",],},{"id":n:404c800000000000,"tick":n:408a200000000000,"day":n:4042000000000000,"year":n:4018000000000000,"type":s:"season","txt":s:"❄️ Winter closes over the world. The stores will decide who sees spring.",},{"id":n:404d000000000000,"tick":n:408b000000000000,"day":n:4042800000000000,"year":n:401c000000000000,"type":s:"season","txt":s:"🌸 Spring returns. The survivors count each other, and begin again.",},{"id":n:404d800000000000,"tick":n:408c400000000000,"day":n:4043000000000000,"year":n:401c000000000000,"type":s:"field","txt":s:"🌱 <b>Embla</b> has turned the soil — the valley's first field lies open to the sky.","agent":n:4008000000000000,"x":n:404c000000000000,"y":n:4046800000000000,},{"id":n:404e000000000000,"tick":n:408d600000000000,"day":n:4044000000000000,"year":n:401c000000000000,"type":s:"failed","txt":s:"<b>Eira</b> tried something with wood — and failed. But failure teaches.","agent":n:3ff0000000000000,},{"id":n:404e800000000000,"tick":n:408ea00000000000,"day":n:4045000000000000,"year":n:401c000000000000,"type":s:"season","txt":s:"❄️ Winter closes over the world. The stores will decide who sees spring.",},{"id":n:404f000000000000,"tick":n:408ec00000000000,"day":n:4045000000000000,"year":n:401c000000000000,"type":s:"trade","txt":s:"🤝 <b>Ask the Founder</b> and <b>Torv the Spearmaker</b> struck a fair trade.","agent":n:4000000000000000,"x":n:404b84438566e5cb,"y":n:4043f99928fd909d,},{"id":n:404f800000000000,"tick":n:408ef00000000000,"day":n:4045000000000000,"year":n:401c000000000000,"type":s:"imitated","txt":s:"<b>Embla</b> has begun believing a great herd walks the night sky, and the living must follow its path, the way Sten does. The custom spreads.","custom":s:"c2",},{"id":n:4050000000000000,"tick":n:408fb80000000000,"day":n:4045800000000000,"year":n:4020000000000000,"type":s:"tech","txt":s:"🧱 <b>Ask</b> built a stone chamber that gathered the heat of the fire — <b>Ask's hearth</b> (Kiln) has been invented! <i>Heat enough to melt what hides in ore and sand.</i>","tech":s:"kiln","agent":n:4000000000000000,"x":n:404bf51259f275fa,"y":n:4044598038970eb5,"causes":[s:"ev:35",s:"ev:49",],},{"id":n:4050400000000000,"tick":n:408fc00000000000,"day":n:4045800000000000,"year":n:4020000000000000,"type":s:"field","txt":s:"🌱 <b>Eira</b> has turned the soil — a new field lies open to the sky.","agent":n:3ff0000000000000,"x":n:4046000000000000,"y":n:403c000000000000,},{"id":n:4050800000000000,"tick":n:40904c0000000000,"day":n:4046000000000000,"year":n:4020000000000000,"type":s:"tech","txt":s:"🔢 <b>Torv</b> matched pebble to sheep and found number itself — <b>Torv's the count</b> (Counting) has been invented! <i>The world made countable — trade, calendars and mathematics begin.</i>","tech":s:"numbers","agent":n:4010000000000000,"x":n:404ccbeca5f5bc78,"y":n:40431237bc90eac4,"causes":[],},{"id":n:4050c00000000000,"tick":n:4090700000000000,"day":n:4046800000000000,"year":n:4020000000000000,"type":s:"tech","txt":s:"🌾 <b>Ask</b> let the wheel drive stones that ground grain — <b>Ask's gristmill</b> (Mill) has been invented! <i>The village can process food — famine recedes.</i>","tech":s:"mill","agent":n:4000000000000000,"x":n:404af7f5e83f8521,"y":n:4043d75e3616e133,"causes":[s:"ev:30",],},{"id":n:4051000000000000,"tick":n:4090880000000000,"day":n:4046800000000000,"year":n:4020000000000000,"type":s:"observed","txt":s:"👁️ <b>Ask</b> noticed that things can be counted, matched and made equal. An idea begins to form.","obs":s:"weightsBalance","agent":n:4000000000000000,"x":n:404af7f5e83f8521,"y":n:4043d75e3616e133,},{"id":n:4051400000000000,"tick":n:4090880000000000,"day":n:4046800000000000,"year":n:4020000000000000,"type":s:"child","txt":s:"👶 <b>Torv</b> and <b>Ask</b> have had a child, <b>Ylva</b> — generation 2. They inherit traits from both.","agent":n:401c000000000000,"x":n:404bebb7d94422de,"y":n:404326387c3b845d,"causes":[s:"agent:4",s:"agent:2",],},{"id":n:4051800000000000,"tick":n:4091780000000000,"day":n:4047800000000000,"year":n:4020000000000000,"type":s:"taught","txt":s:"<b>Eira</b> taught <b>Ylva</b> the secret of Torv's braid. The knowledge spreads.","tech":s:"rope",},{"id":n:4051c00000000000,"tick":n:4091900000000000,"day":n:4048000000000000,"year":n:4020000000000000,"type":s:"season","txt":s:"❄️ Winter closes over the world. The stores will decide who sees spring.",},{"id":n:4052000000000000,"tick":n:4092600000000000,"day":n:4049000000000000,"year":n:4022000000000000,"type":s:"sharing","txt":s:"🍞 <b>Sten</b> shared food with <b>Embla</b>. Those who keep the same ways do not let each other starve.","x":n:404b3dfce7518a6f,"y":n:404889153d716e06,"agent":n:4018000000000000,"causes":[s:"agent:6",s:"agent:3",],},{"id":n:4052400000000000,"tick":n:4093000000000000,"day":n:4049800000000000,"year":n:4022000000000000,"type":s:"tech","txt":s:"📅 <b>Torv</b> counted the stars and seasons into a fixed wheel of days — <b>Torv's the year-wheel</b> (Calendar) has been invented! <i>The future made plannable — harvest, festival and rite find their day.</i>","tech":s:"calendar","agent":n:4010000000000000,"x":n:404a104499ec1be1,"y":n:4043a814d0a48f02,"causes":[s:"ev:66",],},{"id":n:4052800000000000,"tick":n:4093380000000000,"day":n:404a000000000000,"year":n:4022000000000000,"type":s:"tech","txt":s:"🎣 <b>Embla</b> let a twisted line sink where the fish gather — <b>Embla's hookline</b> (Fishing) has been invented! <i>The water becomes a larder — food even when the land gives little.</i>","tech":s:"fishing","agent":n:4008000000000000,"x":n:404b6e8850363c53,"y":n:4046e4b8a038093a,"causes":[s:"ev:11",],},{"id":n:4052c00000000000,"tick":n:4093680000000000,"day":n:404a800000000000,"year":n:4022000000000000,"type":s:"tech","txt":s:"📜 <b>Embla</b> carved signs into clay so knowledge could outlive its owner — <b>Embla's glyphs</b> (Writing) has been invented! <i>Knowledge spreads to all — and to generations to come.</i>","tech":s:"writing","agent":n:4008000000000000,"x":n:404b7b05a55fb247,"y":n:40467c288aa69e7a,"causes":[s:"ev:49",],},{"id":n:4053000000000000,"tick":n:4093680000000000,"day":n:404a800000000000,"year":n:4022000000000000,"type":s:"epithet","txt":s:"✨ From that day on, <b>Embla</b> was known as <b>Embla the Rememberer</b>.","agent":n:4008000000000000,"x":n:404b7b05a55fb247,"y":n:40467c288aa69e7a,},{"id":n:4053400000000000,"tick":n:4093a80000000000,"day":n:404a800000000000,"year":n:4022000000000000,"type":s:"death","txt":s:"<b>Ask the Founder</b> starved to death. Much knowledge died with them — unless someone learned in time.","agent":n:4000000000000000,"x":n:404e85b49f00f49e,"y":n:4043bc03f87ceb90,"cause":s:"starvation","causes":[s:"cause:starvation",],},{"id":n:4053800000000000,"tick":n:4093a80000000000,"day":n:404a800000000000,"year":n:4022000000000000,"type":s:"knowledgeLost","txt":s:"🕯️ With <b>Ask the Founder</b> died the last knowledge of Ask's gristmill (Mill). It is <b>extinct</b> — until someone rediscovers it.","tech":s:"mill",},{"id":n:4053c00000000000,"tick":n:4093c00000000000,"day":n:404a800000000000,"year":n:4022000000000000,"type":s:"tech","txt":s:"🏚️ <b>Embla</b> built a dry raised store so the harvest kept till spring — <b>Embla's silo</b> (Granary) has been invented! <i>Surplus survives winter — the first true wealth.</i>","tech":s:"granary","agent":n:4008000000000000,"x":n:404bc1a91952a6cd,"y":n:40487490acb235ca,"causes":[s:"ev:56",s:"ev:49",],},{"id":n:4054000000000000,"tick":n:4093d00000000000,"day":n:404b000000000000,"year":n:4022000000000000,"type":s:"season","txt":s:"❄️ Winter closes over the world. The stores will decide who sees spring.",},{"id":n:4054400000000000,"tick":n:4093d40000000000,"day":n:404b000000000000,"year":n:4022000000000000,"type":s:"sharing","txt":s:"🍞 <b>Liv</b> shared food with <b>Eira</b>. Those who keep the same ways do not let each other starve.","x":n:4048e4f927bc98f6,"y":n:40402c0ce1f5fd1e,"agent":n:4014000000000000,"causes":[s:"agent:5",s:"agent:1",],},{"id":n:4054800000000000,"tick":n:4093fc0000000000,"day":n:404b000000000000,"year":n:4022000000000000,"type":s:"observed","txt":s:"👁️ <b>Eira</b> noticed that two soft metals poured together wake up hard. An idea begins to form.","obs":s:"bronzeHard","agent":n:3ff0000000000000,"x":n:40469485da3f9f13,"y":n:403d2db2fc6b8e9b,},{"id":n:4054c00000000000,"tick":n:4094180000000000,"day":n:404b000000000000,"year":n:4022000000000000,"type":s:"star","txt":s:"📜✨ <b>Embla the Rememberer</b> pressed the pattern of the stars into clay — the first star-marks. Now the sky can be remembered.","agent":n:4008000000000000,},{"id":n:4055000000000000,"tick":n:4094200000000000,"day":n:404b000000000000,"year":n:4022000000000000,"type":s:"epithet","txt":s:"✨ From that day on, <b>Eira</b> was known as <b>Eira the Rekindler</b>.","agent":n:3ff0000000000000,"x":n:4046a0d1c0ab3255,"y":n:403e12c86a643cc3,},{"id":n:4055400000000000,"tick":n:4094200000000000,"day":n:404b000000000000,"year":n:4022000000000000,"type":s:"rediscovered","txt":s:"💡 <b>Eira the Rekindler</b> has rediscovered Ask's gristmill (Mill) — knowledge lost for 0 years lives again!","tech":s:"mill","agent":n:3ff0000000000000,"x":n:4046a0d1c0ab3255,"y":n:403e12c86a643cc3,"causes":[s:"ev:78",],},{"id":n:4055800000000000,"tick":n:4094600000000000,"day":n:404b800000000000,"year":n:4024000000000000,"type":s:"field","txt":s:"🌱 <b>Torv the Spearmaker</b> has turned the soil — a new field lies open to the sky.","agent":n:4010000000000000,"x":n:4048000000000000,"y":n:403e000000000000,},{"id":n:4055c00000000000,"tick":n:40947c0000000000,"day":n:404b800000000000,"year":n:4024000000000000,"type":s:"star","txt":s:"📜✨ <b>Eira the Rekindler</b> pressed the pattern of the stars into clay — the first star-marks. Now the sky can be remembered.","agent":n:3ff0000000000000,},{"id":n:4056000000000000,"tick":n:4094d00000000000,"day":n:404c000000000000,"year":n:4024000000000000,"type":s:"tech","txt":s:"🧱 <b>Embla</b> fired shaped clay into blocks that stack true — <b>Embla's mudbrick</b> (Brick) has been invented! <i>Walls that outlast weather — the start of building.</i>","tech":s:"brick","agent":n:4008000000000000,"x":n:404e27f8d57cd452,"y":n:4049e31b0893c771,"causes":[s:"ev:49",s:"ev:64",],},{"id":n:4056400000000000,"tick":n:4095180000000000,"day":n:404c800000000000,"year":n:4024000000000000,"type":s:"moved","txt":s:"<b>Eira</b> moved into an abandoned hut.",},{"id":n:4056800000000000,"tick":n:4095780000000000,"day":n:404d000000000000,"year":n:4024000000000000,"type":s:"taught","txt":s:"<b>Eira</b> taught <b>Liv</b> the secret of Embla's urn. The knowledge spreads.","tech":s:"pottery",},{"id":n:4056c00000000000,"tick":n:4095ac0000000000,"day":n:404d800000000000,"year":n:4024000000000000,"type":s:"tech","txt":s:"⚪ <b>Torv</b> smelted a pale metal too soft to be worth much alone — <b>Torv's white metal</b> (Tin) has been invented! <i>Useless alone — everything when married to copper.</i>","tech":s:"tin","agent":n:4010000000000000,"x":n:404a7b9d00c9ffe4,"y":n:4040015eabab5703,"causes":[s:"ev:64",],},{"id":n:4057000000000000,"tick":n:4096100000000000,"day":n:404e000000000000,"year":n:4024000000000000,"type":s:"season","txt":s:"❄️ Winter closes over the world. The stores will decide who sees spring.",},{"id":n:4057400000000000,"tick":n:40967c0000000000,"day":n:404e800000000000,"year":n:4024000000000000,"type":s:"tech","txt":s:"🕳️ <b>Eira</b> lined a deep pit with stone to hold clean water — <b>Eira's stone well</b> (Well) has been invented! <i>Water without walking to the river — a village can grow inland.</i>","tech":s:"well","agent":n:3ff0000000000000,"x":n:404641214b1b567a,"y":n:403cfc3f2e177dd2,"causes":[s:"ev:88",],},{"id":n:4057800000000000,"tick":n:40969c0000000000,"day":n:404e800000000000,"year":n:4026000000000000,"type":s:"failed","txt":s:"<b>Eira</b> tried something with tin — and failed. But failure teaches.","agent":n:3ff0000000000000,},{"id":n:4057c00000000000,"tick":n:4097000000000000,"day":n:404f000000000000,"year":n:4026000000000000,"type":s:"taught","txt":s:"<b>Embla</b> taught <b>Sten</b> the secret of Torv's blaze. The knowledge spreads.","tech":s:"fire",},{"id":n:4058000000000000,"tick":n:4098500000000000,"day":n:4050800000000000,"year":n:4026000000000000,"type":s:"season","txt":s:"❄️ Winter closes over the world. The stores will decide who sees spring.",},{"id":n:4058400000000000,"tick":n:4098c00000000000,"day":n:4050c00000000000,"year":n:4028000000000000,"type":s:"season","txt":s:"🌸 Spring returns. The survivors count each other, and begin again.",},{"id":n:4058800000000000,"tick":n:4099000000000000,"day":n:4050c00000000000,"year":n:4028000000000000,"type":s:"field","txt":s:"🌱 <b>Liv</b> has turned the soil — a new field lies open to the sky.","agent":n:4014000000000000,"x":n:4045000000000000,"y":n:4040800000000000,},{"id":n:4058c00000000000,"tick":n:409a200000000000,"day":n:4051800000000000,"year":n:4028000000000000,"type":s:"tech","txt":s:"🧱 <b>Eira</b> dressed and fitted stone so it stood without mortar — <b>Eira's stonecraft</b> (Masonry) has been invented! <i>Buildings that outlive their builders — the seed of monuments.</i>","tech":s:"masonry","agent":n:3ff0000000000000,"x":n:404b20a97d5b60f3,"y":n:4047c221d097e25a,"causes":[s:"ev:88",],},{"id":n:4059000000000000,"tick":n:409a900000000000,"day":n:4052000000000000,"year":n:4028000000000000,"type":s:"season","txt":s:"❄️ Winter closes over the world. The stores will decide who sees spring.",},{"id":n:4059400000000000,"tick":n:409a980000000000,"day":n:4052000000000000,"year":n:4028000000000000,"type":s:"tech","txt":s:"🛤️ <b>Eira</b> laid stone in a bed so carts ran true in any weather — <b>Eira's trackway</b> (Road) has been invented! <i>Villages bound together — trade, news and armies move.</i>","tech":s:"road","agent":n:3ff0000000000000,"x":n:404a0d2abdc723a0,"y":n:4044859290f6d285,"causes":[s:"ev:30",s:"ev:99",],},{"id":n:4059800000000000,"tick":n:409ad40000000000,"day":n:4052000000000000,"year":n:4028000000000000,"type":s:"tech","txt":s:"🏛️ <b>Eira</b> raised the arch, and space opened under stone — <b>Eira's the arch</b> (Architecture) has been invented! <i>Temples, halls and towers — the shape of a civilization made visible.</i>","tech":s:"architecture","agent":n:3ff0000000000000,"x":n:404a1ddf1082e696,"y":n:4044a30eed7d367b,"causes":[s:"ev:99",],},{"id":n:4059c00000000000,"tick":n:409b300000000000,"day":n:4052400000000000,"year":n:402a000000000000,"type":s:"tech","txt":s:"🌉 <b>Eira</b> carried water across the valley on arches of stone — <b>Eira's conduit</b> (Aqueduct) has been invented! <i>Cities freed from the river — population without limit of the well.</i>","tech":s:"aqueduct","agent":n:3ff0000000000000,"x":n:404a07ec36f8fcf5,"y":n:404469c6a2168c3d,"causes":[s:"ev:102",s:"ev:93",],},{"id":n:405a000000000000,"tick":n:409b6c0000000000,"day":n:4052800000000000,"year":n:402a000000000000,"type":s:"tech","txt":s:"🌬️ <b>Eira</b> set great sails to catch the wind and turn the stones — <b>Eira's tower-mill</b> (Windmill) has been invented! <i>Grinding and pumping without river or muscle.</i>","tech":s:"windmill","agent":n:3ff0000000000000,"x":n:404a0bee476278af,"y":n:40446991f3e9c199,"causes":[s:"ev:67",s:"ev:102",],},{"id":n:405a400000000000,"tick":n:409c300000000000,"day":n:4053000000000000,"year":n:402a000000000000,"type":s:"taught","txt":s:"<b>Torv</b> taught <b>Ylva</b> the secret of Torv's blaze. The knowledge spreads.","tech":s:"fire",},{"id":n:405a800000000000,"tick":n:409cbc0000000000,"day":n:4053400000000000,"year":n:402a000000000000,"type":s:"taught","txt":s:"<b>Torv</b> taught <b>Ylva</b> the secret of Torv's lodge. The knowledge spreads.","tech":s:"hut",},{"id":n:405ac00000000000,"tick":n:409cd00000000000,"day":n:4053800000000000,"year":n:402a000000000000,"type":s:"season","txt":s:"❄️ Winter closes over the world. The stores will decide who sees spring.",},{"id":n:405b000000000000,"tick":n:409d040000000000,"day":n:4053800000000000,"year":n:402a000000000000,"type":s:"observed","txt":s:"👁️ <b>Eira</b> noticed that a struck string and a hollow log ring with a voice. An idea begins to form.","obs":s:"soundsRing","agent":n:3ff0000000000000,"x":n:40483d6dbd7163e4,"y":n:40432279d961908d,},{"id":n:405b400000000000,"tick":n:409d080000000000,"day":n:4053800000000000,"year":n:402a000000000000,"type":s:"taught","txt":s:"<b>Eira</b> taught <b>Liv</b> the secret of Eira's stone well. The knowledge spreads.","tech":s:"well",},{"id":n:405b800000000000,"tick":n:409d400000000000,"day":n:4053c00000000000,"year":n:402c000000000000,"type":s:"season","txt":s:"🌸 Spring returns. The survivors count each other, and begin again.",},{"id":n:405bc00000000000,"tick":n:409d600000000000,"day":n:4053c00000000000,"year":n:402c000000000000,"type":s:"field","txt":s:"🌱 <b>Sten</b> has turned the soil — a new field lies open to the sky.","agent":n:4018000000000000,"x":n:4049800000000000,"y":n:403c000000000000,},{"id":n:405c000000000000,"tick":n:409db00000000000,"day":n:4054000000000000,"year":n:402c000000000000,"type":s:"tech","txt":s:"🎨 <b>Eira</b> ground coloured earth and left an image on the wall — <b>Eira's pigmentwork</b> (Painting) has been invented! <i>The world seen, kept and shared — visual art is born.</i>","tech":s:"painting","agent":n:3ff0000000000000,"x":n:40478c8c2c129718,"y":n:4042770869c1908d,"causes":[s:"ev:2",],},{"id":n:405c400000000000,"tick":n:409db40000000000,"day":n:4054000000000000,"year":n:402c000000000000,"type":s:"tech","txt":s:"🧠 <b>Embla</b> asked not what the world is but why, and wrote it down — <b>Embla's the argument</b> (Philosophy) has been invented! <i>Reasoned thought — the seed of law, science and doubt.</i>","tech":s:"philosophy","agent":n:4008000000000000,"x":n:404a9a73c53618f7,"y":n:403f9de730dee554,"causes":[s:"ev:75",],},{"id":n:405c800000000000,"tick":n:409dcc0000000000,"day":n:4054000000000000,"year":n:402c000000000000,"type":s:"tech","txt":s:"🌿 <b>Eira</b> learned which leaves ease pain and close a wound — <b>Eira's the healer</b> (Medicine) has been invented! <i>Death held off a while — the healer becomes needed.</i>","tech":s:"medicine","agent":n:3ff0000000000000,"x":n:40478c8c2c129718,"y":n:4042770869c1908d,"causes":[],},{"id":n:405cc00000000000,"tick":n:409e140000000000,"day":n:4054400000000000,"year":n:402c000000000000,"type":s:"tech","txt":s:"🎼 <b>Embla</b> wrote music down so a song could outlive its singer — <b>Embla's written music</b> (Composition) has been invented! <i>Music made lasting and grand — the composer, the choir, the hall.</i>","tech":s:"composition","agent":n:4008000000000000,"x":n:404a48c14d0b4c2a,"y":n:403ff842c962e553,"causes":[s:"ev:47",s:"ev:75",],},{"id":n:405d000000000000,"tick":n:409ea00000000000,"day":n:4054800000000000,"year":n:402c000000000000,"type":s:"star","txt":s:"✨ <b>Liv</b> lay awake in the dark and watched the lights that do not fall.","agent":n:4014000000000000,"x":n:4048d24ba116dacd,"y":n:40446194c034ad63,},{"id":n:405d400000000000,"tick":n:409ee40000000000,"day":n:4054c00000000000,"year":n:402c000000000000,"type":s:"taught","txt":s:"<b>Torv</b> taught <b>Ylva</b> the secret of Torv's melody. The knowledge spreads.","tech":s:"song",},{"id":n:405d800000000000,"tick":n:409f100000000000,"day":n:4055000000000000,"year":n:402c000000000000,"type":s:"season","txt":s:"❄️ Winter closes over the world. The stores will decide who sees spring.",},{"id":n:405dc00000000000,"tick":n:409ff00000000000,"day":n:4055800000000000,"year":n:402e000000000000,"type":s:"taught","txt":s:"<b>Embla</b> taught <b>Sten</b> the secret of Torv's the loom. The knowledge spreads.","tech":s:"weaving",},{"id":n:405e000000000000,"tick":n:40a0a80000000000,"day":n:4056800000000000,"year":n:402e000000000000,"type":s:"season","txt":s:"❄️ Winter closes over the world. The stores will decide who sees spring.",},{"id":n:405e400000000000,"tick":n:40a13a0000000000,"day":n:4057400000000000,"year":n:4030000000000000,"type":s:"failed","txt":s:"<b>Embla</b> tried something with iron and wood — and failed. But failure teaches.","agent":n:4008000000000000,},{"id":n:405e800000000000,"tick":n:40a14c0000000000,"day":n:4057400000000000,"year":n:4030000000000000,"type":s:"tech","txt":s:"⚒️ <b>Embla</b> watched gleaming metal run from the glowing ore — <b>Embla's ironcraft</b> (Iron smithing) has been invented! <i>Metal — an entirely new material.</i>","tech":s:"smithing","agent":n:4008000000000000,"x":n:4049ee6ea37e7536,"y":n:40401c3fc4f9b788,"causes":[s:"ev:64",],},{"id":n:405ec00000000000,"tick":n:40a18e0000000000,"day":n:4057800000000000,"year":n:4030000000000000,"type":s:"tech","txt":s:"⛏️ <b>Embla</b> forged the iron into an edge that never dulled — <b>Embla's plough</b> (Metal tools) has been invented! <i>Three times faster work.</i>","tech":s:"metaltools","agent":n:4008000000000000,"x":n:40488ec9820532c9,"y":n:40406864ef438af0,"causes":[s:"ev:122",],},{"id":n:405f000000000000,"tick":n:40a1920000000000,"day":n:4057800000000000,"year":n:4030000000000000,"type":s:"taught","txt":s:"<b>Torv</b> taught <b>Liv</b> the secret of Torv's lodge. The knowledge spreads.","tech":s:"hut",},{"id":n:405f400000000000,"tick":n:40a1920000000000,"day":n:4057800000000000,"year":n:4030000000000000,"type":s:"custom","txt":s:"🌿 <b>Liv</b> began carving a sign into a flat stone — no one told them to. Others may follow. <i>(Carving a sign into a flat stone)</i>","custom":s:"c3","agent":n:4014000000000000,"x":n:404b6d433c902c4e,"y":n:403c1273cd301e94,"label":s:"A CUSTOM APPEARS",},{"id":n:405f800000000000,"tick":n:40a1920000000000,"day":n:4057800000000000,"year":n:4030000000000000,"type":s:"hut","txt":s:"🛖 <b>Liv</b> built a hut.","x":n:404b6d433c902c4e,"y":n:403c1273cd301e94,},{"id":n:405fc00000000000,"tick":n:40a1c80000000000,"day":n:4058000000000000,"year":n:4030000000000000,"type":s:"season","txt":s:"❄️ Winter closes over the world. The stores will decide who sees spring.",},{"id":n:4060000000000000,"tick":n:40a1ce0000000000,"day":n:4058000000000000,"year":n:4030000000000000,"type":s:"child","txt":s:"👶 <b>Embla</b> and <b>Torv</b> have had a child, <b>Bjorn</b> — generation 2. They inherit traits from both.","agent":n:4020000000000000,"x":n:404a30500ac1a5aa,"y":n:40408c5773ca34de,"causes":[s:"agent:3",s:"agent:4",],},{"id":n:4060200000000000,"tick":n:40a2000000000000,"day":n:4058400000000000,"year":n:4031000000000000,"type":s:"season","txt":s:"🌸 S