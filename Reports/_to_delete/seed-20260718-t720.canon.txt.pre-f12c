{"meta":{"seed":n:41735276e0000000,"ticksRequested":n:4086800000000000,"founders":null,"engine":s:"emergence-engine.js","engineVersion":s:"2.6.0",},"events":[{"id":n:0000000000000000,"tick":n:0000000000000000,"day":n:3ff0000000000000,"year":n:3ff0000000000000,"type":s:"start","txt":s:"🌍 Four humans wake in an untouched world: <b>Eira</b>, <b>Ask</b>, <b>Embla</b>, <b>Torv</b>. They know nothing — but they can observe everything. What will they create?",},{"id":n:3ff0000000000000,"tick":n:401c000000000000,"day":n:3ff0000000000000,"year":n:3ff0000000000000,"type":s:"failed","txt":s:"<b>Embla</b> tried something with  — and failed. But failure teaches.","agent":n:4008000000000000,},{"id":n:4000000000000000,"tick":n:4022000000000000,"day":n:3ff0000000000000,"year":n:3ff0000000000000,"type":s:"tech","txt":s:"📖 <b>Eira</b> told the day back as a story worth remembering — <b>Eira's oral saga</b> (Storytelling) has been invented! <i>The first culture — memory shaped into meaning.</i>","tech":s:"storytelling","agent":n:3ff0000000000000,"x":n:40495ebcda313333,"y":n:4042a9742343cccd,"causes":[],},{"id":n:4008000000000000,"tick":n:4022000000000000,"day":n:3ff0000000000000,"year":n:3ff0000000000000,"type":s:"custom","txt":s:"🌿 <b>Eira</b> began believing the world repeats and can be understood — no one told them to. Others may follow. <i>(The Knowing Eye)</i>","custom":s:"c1","agent":n:3ff0000000000000,"x":n:40495ebcda313333,"y":n:4042a9742343cccd,"label":s:"A NEW WAY OF SEEING",},{"id":n:4010000000000000,"tick":n:4045800000000000,"day":n:4008000000000000,"year":n:3ff0000000000000,"type":s:"star","txt":s:"✨ <b>Eira</b> lay awake in the dark and watched the lights that do not fall.","agent":n:3ff0000000000000,"x":n:40490168f4de3125,"y":n:40437de9d69641f9,},{"id":n:4014000000000000,"tick":n:4045800000000000,"day":n:4008000000000000,"year":n:3ff0000000000000,"type":s:"star","txt":s:"✨ <b>Ask</b> lay awake in the dark and watched the lights that do not fall.","agent":n:4000000000000000,"x":n:4048ebace4d366dd,"y":n:404756aeb41688c4,},{"id":n:4018000000000000,"tick":n:4046000000000000,"day":n:4008000000000000,"year":n:3ff0000000000000,"type":s:"tech","txt":s:"🔪 <b>Eira</b> struck two stones together and kept the sharp shard — <b>Eira's knife</b> (Sharpened stone) has been invented! <i>Faster gathering of everything.</i>","tech":s:"sharp","agent":n:3ff0000000000000,"x":n:40490168f4de3125,"y":n:40437de9d69641f9,"causes":[],},{"id":n:401c000000000000,"tick":n:4056800000000000,"day":n:4014000000000000,"year":n:3ff0000000000000,"type":s:"star","txt":s:"✨ <b>Eira</b> watches the stars again, night after night. Something is taking shape.","agent":n:3ff0000000000000,},{"id":n:4020000000000000,"tick":n:405d000000000000,"day":n:4018000000000000,"year":n:3ff0000000000000,"type":s:"season","txt":s:"❄️ The first winter has come. The world turns white and hard, and the nights grow long. Fire is no longer comfort — it is life.",},{"id":n:4022000000000000,"tick":n:4061200000000000,"day":n:4018000000000000,"year":n:3ff0000000000000,"type":s:"star","txt":s:"✨ <b>Embla</b> lay awake in the dark and watched the lights that do not fall.","agent":n:4008000000000000,"x":n:4049e9ff6dd1c77e,"y":n:4042f4f892f3c137,},{"id":n:4024000000000000,"tick":n:4064400000000000,"day":n:4020000000000000,"year":n:4000000000000000,"type":s:"star","txt":s:"✨ <b>Torv</b> lay awake in the dark and watched the lights that do not fall.","agent":n:4010000000000000,"x":n:404ea1e41db6e5d0,"y":n:4037b9f7266633b6,},{"id":n:4026000000000000,"tick":n:4067e00000000000,"day":n:4022000000000000,"year":n:4000000000000000,"type":s:"tech","txt":s:"🪢 <b>Torv</b> twisted grass fibers into something strong — <b>Torv's braid</b> (Rope) has been invented! <i>Makes it possible to bind parts together.</i>","tech":s:"rope","agent":n:4010000000000000,"x":n:404daadd9b837f6a,"y":n:40363eabbd7033b5,"causes":[],},{"id":n:4028000000000000,"tick":n:406c200000000000,"day":n:4024000000000000,"year":n:4000000000000000,"type":s:"taught","txt":s:"<b>Eira</b> taught <b>Ask</b> the secret of Eira's knife. The knowledge spreads.","tech":s:"sharp",},{"id":n:402a000000000000,"tick":n:406c200000000000,"day":n:4024000000000000,"year":n:4000000000000000,"type":s:"child","txt":s:"👶 <b>Eira</b> and <b>Ask</b> have had a child, <b>Liv</b> — generation 2. They inherit traits from both.","agent":n:4014000000000000,"x":n:404743801e5ce882,"y":n:40436f6dd5ae5e02,"causes":[s:"agent:1",s:"agent:2",],},{"id":n:402c000000000000,"tick":n:4070400000000000,"day":n:4028000000000000,"year":n:4000000000000000,"type":s:"season","txt":s:"❄️ Winter closes over the world. The stores will decide who sees spring.",},{"id":n:402e000000000000,"tick":n:4070900000000000,"day":n:4028000000000000,"year":n:4000000000000000,"type":s:"tech","txt":s:"🧶 <b>Torv</b> crossed threads over threads until cloth grew on the frame — <b>Torv's the loom</b> (Weaving) has been invented! <i>Cloth for warmth and trade — and hands that specialize.</i>","tech":s:"weaving","agent":n:4010000000000000,"x":n:404b82073ad465ef,"y":n:40377fbdd99dcdda,"causes":[s:"ev:11",],},{"id":n:4030000000000000,"tick":n:4071800000000000,"day":n:4028000000000000,"year":n:4000000000000000,"type":s:"star","txt":s:"✨ <b>Ask</b> watches the stars again, night after night. Something is taking shape.","agent":n:4000000000000000,},{"id":n:4031000000000000,"tick":n:4071b00000000000,"day":n:402a000000000000,"year":n:4000000000000000,"type":s:"custom","txt":s:"🌿 <b>Torv</b> began believing a great herd walks the night sky, and the living must follow its path — no one told them to. Others may follow. <i>(the Sky-Wheel)</i>","custom":s:"c2","agent":n:4010000000000000,"x":n:4049a3449f25f3d8,"y":n:403e28f29c0a827e,"label":s:"A NEW WAY OF SEEING",},{"id":n:4032000000000000,"tick":n:4071b00000000000,"day":n:402a000000000000,"year":n:4000000000000000,"type":s:"star","txt":s:"🌌 <b>Torv</b> saw a pattern in the stars and gave it a name — <b>the Sky-Wheel</b>. From watching, a cosmology is born: the first faith of the sky.","agent":n:4010000000000000,"label":s:"A RELIGION OF THE SKY",},{"id":n:4033000000000000,"tick":n:4072000000000000,"day":n:402a000000000000,"year":n:4008000000000000,"type":s:"season","txt":s:"🌸 Spring returns. The survivors count each other, and begin again.",},{"id":n:4034000000000000,"tick":n:4074800000000000,"day":n:402c000000000000,"year":n:4008000000000000,"type":s:"star","txt":s:"✨ <b>Embla</b> watches the stars again, night after night. Something is taking shape.","agent":n:4008000000000000,},{"id":n:4035000000000000,"tick":n:4078a00000000000,"day":n:4031000000000000,"year":n:4008000000000000,"type":s:"failed","txt":s:"<b>Torv</b> tried something with wood and stone and fiber — and failed. But failure teaches.","agent":n:4010000000000000,},{"id":n:4036000000000000,"tick":n:4079100000000000,"day":n:4031000000000000,"year":n:4008000000000000,"type":s:"tech","txt":s:"🗡️ <b>Torv</b> lashed a sharp point to a long shaft — <b>Torv's pike</b> (Spear) has been invented! <i>Humans are prey no longer. Deer can be hunted — food even in winter.</i>","tech":s:"spear","agent":n:4010000000000000,"x":n:404808ed4c28bcad,"y":n:40434ed13133361a,"causes":[s:"ev:6",s:"ev:11",],},{"id":n:4037000000000000,"tick":n:4079100000000000,"day":n:4031000000000000,"year":n:4008000000000000,"type":s:"epithet","txt":s:"✨ From that day on, <b>Torv</b> was known as <b>Torv the Spearmaker</b>.","agent":n:4010000000000000,"x":n:404808ed4c28bcad,"y":n:40434ed13133361a,},{"id":n:4038000000000000,"tick":n:4079400000000000,"day":n:4032000000000000,"year":n:4008000000000000,"type":s:"season","txt":s:"❄️ Winter closes over the world. The stores will decide who sees spring.",},{"id":n:4039000000000000,"tick":n:407aa00000000000,"day":n:4033000000000000,"year":n:4008000000000000,"type":s:"tech","txt":s:"🪓 <b>Torv</b> bound a hard edge to a wooden shaft — <b>Torv's hewer</b> (Axe) has been invented! <i>Twice as fast logging. Required to build huts.</i>","tech":s:"axe","agent":n:4010000000000000,"x":n:40477164bf5abcad,"y":n:4042eaf99f913619,"causes":[s:"ev:6",s:"ev:11",],},{"id":n:403a000000000000,"tick":n:407bc00000000000,"day":n:4033000000000000,"year":n:4010000000000000,"type":s:"observed","txt":s:"👁️ <b>Liv</b> noticed that grass fibers hold when twisted. An idea begins to form.","obs":s:"fibersTwist","agent":n:4014000000000000,"x":n:4049c6678cb23294,"y":n:4044721962521301,},{"id":n:403b000000000000,"tick":n:407ea00000000000,"day":n:4035000000000000,"year":n:4010000000000000,"type":s:"hoard","txt":s:"🏺 <b>Ask</b> has begun laying up stores beyond any need. The pile grows — and eyes have begun to follow it.","agent":n:4000000000000000,"x":n:4048dbb78d95966a,"y":n:4044c3d077816582,"causes":[s:"agent:2",],},{"id":n:403c000000000000,"tick":n:407fe00000000000,"day":n:4036000000000000,"year":n:4010000000000000,"type":s:"tech","txt":s:"🛖 <b>Torv</b> raised logs against each other into a shelter — <b>Torv's lodge</b> (Hut) has been invented! <i>Shelter and warmth at night. Three huts close together become a village.</i>","tech":s:"hut","agent":n:4010000000000000,"x":n:40480d5e6e2eefe1,"y":n:40440bbfe67d3618,"causes":[s:"ev:25",],},{"id":n:403d000000000000,"tick":n:4080700000000000,"day":n:4037000000000000,"year":n:4010000000000000,"type":s:"child","txt":s:"👶 <b>Embla</b> and <b>Torv</b> have had a child, <b>Sten</b> — generation 2. They inherit traits from both.","agent":n:4018000000000000,"x":n:4048eeb2720b54bc,"y":n:404470b6a5a725c8,"causes":[s:"agent:3",s:"agent:4",],},{"id":n:403e000000000000,"tick":n:4080780000000000,"day":n:4037000000000000,"year":n:4010000000000000,"type":s:"tech","txt":s:"🛞 <b>Torv</b> watched a log roll and understood something great — <b>Torv's pulley</b> (The Wheel) has been invented! <i>The foundation of mills, carts — and everything that spins.</i>","tech":s:"wheel","agent":n:4010000000000000,"x":n:4047d1b39829bcae,"y":n:40444459166e02e5,"causes":[s:"ev:25",],},{"id":n:403f000000000000,"tick":n:4080b80000000000,"day":n:4037000000000000,"year":n:4010000000000000,"type":s:"failed","txt":s:"<b>Ask</b> tried something with stone and wood and fiber — and failed. But failure teaches.","agent":n:4000000000000000,},{"id":n:4040000000000000,"tick":n:4080c80000000000,"day":n:4037000000000000,"year":n:4010000000000000,"type":s:"tech","txt":s:"🏹 <b>Torv</b> bent a young branch with a cord and felt it fight back — <b>Torv's hunting bow</b> (Bow) has been invented! <i>The hunt no longer needs closeness. Deer fall at a distance.</i>","tech":s:"bow","agent":n:4010000000000000,"x":n:40483c50af552314,"y":n:40447966cfd03618,"causes":[s:"ev:22",s:"ev:11",],},{"id":n:4040800000000000,"tick":n:4081100000000000,"day":n:4038000000000000,"year":n:4010000000000000,"type":s:"hoard","txt":s:"🏺 <b>Torv the Spearmaker</b> has begun laying up stores beyond any need. The pile grows — and eyes have begun to follow it.","agent":n:4010000000000000,"x":n:404812450186cdc9,"y":n:40448be66cfe87f1,"causes":[s:"agent:4",],},{"id":n:4041000000000000,"tick":n:4081200000000000,"day":n:4038000000000000,"year":n:4010000000000000,"type":s:"season","txt":s:"❄️ Winter closes over the world. The stores will decide who sees spring.",},{"id":n:4041800000000000,"tick":n:4081700000000000,"day":n:4038000000000000,"year":n:4010000000000000,"type":s:"tech","txt":s:"🔥 <b>Torv</b> rubbed sticks together until a spark caught the tinder — <b>Torv's blaze</b> (Fire) has been invented! <i>Warmth at night. Opens the path to pottery and smithing.</i>","tech":s:"fire","agent":n:4010000000000000,"x":n:40485284fdfb6762,"y":n:404577f7f426ee57,"causes":[],},{"id":n:4042000000000000,"tick":n:4082000000000000,"day":n:4039000000000000,"year":n:4014000000000000,"type":s:"tech","txt":s:"⛵ <b>Torv</b> stretched cloth on a hull and let the wind do the work — <b>Torv's river-craft</b> (Sailing) has been invented! <i>Rivers and coasts become roads — trade and migration by water.</i>","tech":s:"sailing","agent":n:4010000000000000,"x":n:4047fbcd4e55342d,"y":n:404548f9f52c87f3,"causes":[s:"ev:15",s:"ev:25",],},{"id":n:4042800000000000,"tick":n:4082000000000000,"day":n:4039000000000000,"year":n:4014000000000000,"type":s:"season","txt":s:"🌸 Spring returns. The survivors count each other, and begin again.",},{"id":n:4043000000000000,"tick":n:4082100000000000,"day":n:4039000000000000,"year":n:4014000000000000,"type":s:"failed","txt":s:"<b>Embla</b> tried something with wood and fiber — and failed. But failure teaches.","agent":n:4008000000000000,},{"id":n:4043800000000000,"tick":n:4082380000000000,"day":n:4039000000000000,"year":n:4014000000000000,"type":s:"hut","txt":s:"🛖 <b>Torv</b> built a hut.","x":n:4047e6fadd396760,"y":n:404539b8c268bb26,},{"id":n:4044000000000000,"tick":n:4082700000000000,"day":n:4039000000000000,"year":n:4014000000000000,"type":s:"hut","txt":s:"🛖 <b>Embla</b> built a hut.","x":n:4049be5fd370b3cf,"y":n:4044dfef0fabe460,},{"id":n:4044800000000000,"tick":n:4083000000000000,"day":n:403a000000000000,"year":n:4014000000000000,"type":s:"observed","txt":s:"👁️ <b>Embla</b> noticed that fire makes clay hard. An idea begins to form.","obs":s:"heatHardens","agent":n:4008000000000000,"x":n:4049c36a8b61e703,"y":n:4045765bf4007dfa,},{"id":n:4045000000000000,"tick":n:4083080000000000,"day":n:403a000000000000,"year":n:4014000000000000,"type":s:"hut","txt":s:"🛖 <b>Ask</b> built a hut.","x":n:404a595bb1c37453,"y":n:4044c82c75bceefb,},{"id":n:4045800000000000,"tick":n:4083080000000000,"day":n:403a000000000000,"year":n:4014000000000000,"type":s:"epithet","txt":s:"✨ From that day on, <b>Ask</b> was known as <b>Ask the Founder</b>.","agent":n:4000000000000000,"x":n:404a595bb1c37453,"y":n:4044c82c75bceefb,},{"id":n:4046000000000000,"tick":n:4083080000000000,"day":n:403a000000000000,"year":n:4014000000000000,"type":s:"village","txt":s:"🏘️ Three huts have become more — <b>Askheim</b> has been founded! A village born of nothing but cooperation.","village":s:"Askheim","x":n:404a595bb1c37453,"y":n:4044c82c75bceefb,"causes":[s:"agent:2",],},{"id":n:4046800000000000,"tick":n:4085a00000000000,"day":n:403e000000000000,"year":n:4014000000000000,"type":s:"season","txt":s:"❄️ Winter closes over the world. The stores will decide who sees spring.",},{"id":n:4047000000000000,"tick":n:4086580000000000,"day":n:403f000000000000,"year":n:4014000000000000,"type":s:"failed","txt":s:"<b>Embla</b> tried something with wood and fiber — and failed. But failure teaches.","agent":n:4008000000000000,},],"dna":{"seed":n:41735276e0000000,"years":n:4018000000000000,"dna":{"Curious":n:403d000000000000,"Social":n:4041000000000000,"Diligent":n:4042800000000000,},"population":n:4018000000000000,"maxPop":n:4018000000000000,"generations":n:4000000000000000,"knowledgeCount":n:4026000000000000,"knowledgeMax":n:404a800000000000,"villages":[s:"Askheim",],"births":n:4000000000000000,"talks":n:4047000000000000,"deaths":{"starvation":n:0000000000000000,"cold":n:0000000000000000,"age":n:0000000000000000,"wolves":n:0000000000000000,},"knowledgeLosses":n:0000000000000000,"rediscoveries":n:0000000000000000,"failedExperiments":n:4033000000000000,"observations":n:4038000000000000,"customsCount":n:4000000000000000,"traditions":[],"taboos":[],"beliefs":[s:"The Knowing Eye",s:"the Sky-Wheel",],"conversions":n:0000000000000000,"hunts":n:0000000000000000,"harshWinters":n:0000000000000000,"reformations":n:0000000000000000,"worldview":s:"empiric","tabooBreaks":n:0000000000000000,"religions":[undef,],"legends":[s:"Torv Torv the Spearmaker.",s:"Ask Ask the Founder.",],"milestones":{"⚙️ Storytelling":s:"year 1","⚙️ Sharpened stone":s:"year 1","⚙️ Rope":s:"year 2","👶 First child":s:"year 2","⚙️ Weaving":s:"year 2","⚙️ Spear":s:"year 3","⚙️ Axe":s:"year 3","⚙️ Hut":s:"year 4","⚙️ The Wheel":s:"year 4","⚙️ Bow":s:"year 4","⚙️ Fire":s:"year 4","⚙️ Sailing":s:"year 5","🏘️ First village":s:"year 5",},"status":s:"Alive in year 6","violence":{"steals":n:0000000000000000,"raids":n:0000000000000000,"feuds":n:0000000000000000,"killings":n:0000000000000000,"brawls":n:0000000000000000,"wars":n:0000000000000000,},"trades":n:4000000000000000,"gifts":n:0000000000000000,"leaders":[],"giftWays":[],"wealthTop":s:"Ask the Founder (17)",},"history":{"worldName":s:"Askheim","seed":n:41735276e0000000,"years":n:4018000000000000,"intro":s:"This is the chronicle of Askheim - 6 years, 2 generations, written by no one. Every line below happened.","outro":s:"The chronicle is still being written. 6 souls carry it onward.","chapters":[{"title":s:"The Waking","from":n:3ff0000000000000,"to":n:4018000000000000,"text":[s:"🌍 Four humans wake in an untouched world: Eira, Ask, Embla, Torv. They know nothing — but they can observe everything. What will they create?",s:"It was in the year 1, when Eira told the day back as a story worth remembering. Eira's oral saga entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 1, when Eira struck two stones together and kept the sharp shard. Eira's knife entered the world, and nothing was quite the same after.",s:"It was in the year 2, when Torv twisted grass fibers into something strong. Torv's braid entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 2, when Torv crossed threads over threads until cloth grew on the frame. Torv's the loom entered the world, and nothing was quite the same after.",s:"It was in the year 3, when Torv lashed a sharp point to a long shaft. Torv's pike entered the world, and nothing was quite the same after.",s:"In the year 3, when Torv bound a hard edge to a wooden shaft. Torv's hewer entered the world, and nothing was quite the same after.",s:"The chronicle marks the year 4, when Torv raised logs against each other into a shelter. Torv's lodge entered the world, and nothing was quite the same after.",s:"In the year 4, when Torv watched a log roll and understood something great. Torv's pulley entered the world, and nothing was quite the same after.",s:"In the year 4, when Torv bent a young branch with a cord and felt it fight back. Torv's hunting bow entered the world, and nothing was quite the same after.",s:"It was in the year 4, when Torv rubbed sticks together until a spark caught the tinder. Torv's blaze entered the world, and nothing was quite the same after.",s:"It was in the year 5, when Torv stretched cloth on a hull and let the wind do the work. Torv's river-craft entered the world, and nothing was quite the same after.",s:"In the year 5, three huts grew into more, and Askheim was founded - a place with a name, which is the beginning of belonging.",s:"In the year 1, Eira began seeing the world differently - believing the world repeats and can be understood. Where others saw spirits, they saw patterns.",s:"In the year 2, Torv began seeing the world differently - believing a great herd walks the night sky, and the living must follow its path. Where others saw patterns, they felt a will behind them.",s:"From that day on, Torv was known as Torv the Spearmaker.",s:"From that day on, Ask was known as Ask the Founder.",s:"Meanwhile 2 children were born under its skies.",],},],},"endState":{"tick":n:4086800000000000,"hour":n:4018000000000000,"day":n:403f000000000000,"season":s:"spring","ended":false,"endedYear":undef,"maxPop":n:4018000000000000,"nextId":n:401c000000000000,"nextCustomId":n:4008000000000000,"nextAnimalId":n:404c000000000000,"maxGeneration":n:4000000000000000,"usedNames":n:4018000000000000,"winterSeverity":n:3ff7fec0f7c33333,"seenWinter":true,"brewing":null,"stats":{"talks":n:4047000000000000,"births":n:4000000000000000,"deaths":{"starvation":n:0000000000000000,"cold":n:0000000000000000,"age":n:0000000000000000,"wolves":n:0000000000000000,},"failedExperiments":n:4033000000000000,"observations":n:4038000000000000,"conversions":n:0000000000000000,"hunts":n:0000000000000000,"harshWinters":n:0000000000000000,"trades":n:4000000000000000,},"traitSum":{"curiosity":n:4006bc48fe80cccc,"social":n:400ab44a9bde0000,"diligence":n:400d98d6