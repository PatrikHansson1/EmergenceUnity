9f1f3f,},{"id":n:40bf170000000000,"tick":n:40e8aa0000000000,"day":n:40a0720000000000,"year":n:4075f00000000000,"type":s:"steal","txt":s:"🥀 Hunger owned the hand: <b>Loke II</b> wrenched food from <b>Bjorn II</b>.","agent":n:4076000000000000,"victim":n:4078e00000000000,"x":n:403e79671893537d,"y":n:404001bd3aff2ed6,"cause":s:"desperation","causes":[s:"agent:398",s:"cause:desperation",],},{"id":n:40bf180000000000,"tick":n:40e8aa4000000000,"day":n:40a0740000000000,"year":n:4075f00000000000,"type":s:"field","txt":s:"🌾 <b>Ylva II the Oathbreaker</b> brings in the harvest from Ylva II's field. Winter holds less fear now.","agent":n:407ab00000000000,"x":n:4043800000000000,"y":n:403b000000000000,},{"id":n:40bf190000000000,"tick":n:40e8aa6000000000,"day":n:40a0740000000000,"year":n:4075f00000000000,"type":s:"field","txt":s:"🌾 <b>Signe II the Oathbreaker</b> brings in the harvest from Signe II's field. Winter holds less fear now.","agent":n:4075900000000000,"x":n:4049000000000000,"y":n:404c800000000000,},{"id":n:40bf1a0000000000,"tick":n:40e8aa8000000000,"day":n:40a0740000000000,"year":n:4075f00000000000,"type":s:"star","txt":s:"✨ <b>Otto II</b> watches the stars again, night after night. Something is taking shape.","agent":n:407da00000000000,},{"id":n:40bf1b0000000000,"tick":n:40e8aa8000000000,"day":n:40a0740000000000,"year":n:4075f00000000000,"type":s:"season","txt":s:"❄️ Winter closes over the world. The stores will decide who sees spring.",},{"id":n:40bf1c0000000000,"tick":n:40e8aaa000000000,"day":n:40a0740000000000,"year":n:4075f00000000000,"type":s:"tabooBroken","txt":s:"⚡ <b>Sten II</b> has broken The Ban of the Living Trees — gathering wood to survive. Guilt follows; so may division.","custom":s:"c32","agent":n:4076e00000000000,"x":n:404f5e5b89b04de3,"y":n:40427c13e91eafbe,},{"id":n:40bf1d0000000000,"tick":n:40e8aaa000000000,"day":n:40a0740000000000,"year":n:4075f00000000000,"type":s:"epithet","txt":s:"✨ From that day on, <b>Sten II</b> was known as <b>Sten II the Oath