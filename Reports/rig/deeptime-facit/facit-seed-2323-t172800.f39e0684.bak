.","agent":n:4082300000000000,"x":n:4042d438e4f84b6a,"y":n:403f4b20239e2b69,},{"id":n:40c42d0000000000,"tick":n:40ed364000000000,"day":n:40a37c0000000000,"year":n:407a000000000000,"type":s:"hunt","txt":s:"🎣 <b>Vera II</b> pulled silver from the water.","agent":n:4081980000000000,"x":n:405094db3c41f1aa,"y":n:404833b82742e947,},{"id":n:40c42d8000000000,"tick":n:40ed36a000000000,"day":n:40a37c0000000000,"year":n:407a000000000000,"type":s:"hoard","txt":s:"🏺 <b>Falk II</b> has begun laying up stores beyond any need. The pile grows — and eyes have begun to follow it.","agent":n:4082a00000000000,"x":n:404f9424445896f9,"y":n:40401dfb02e9d308,"causes":[s:"agent:596",],},{"id":n:40c42e0000000000,"tick":n:40ed380000000000,"day":n:40a37c0000000000,"year":n:407a000000000000,"type":s:"taught","txt":s:"<b>Tuva II</b> taught <b>Sixten II</b> the secret of Ask's the year-wheel. The knowledge spreads.","tech":s:"calendar",},{"id":n:40c42e8000000000,"tick":n:40ed394000000000,"day":n:40a37e0000000000,"year":n:407a000000000000,"type":s:"observed","txt":s:"👁️ <b>Loke II</b> noticed that grass fibers hold when twisted. An idea begins to form.","obs":s:"fibersTwist","agent":n:4083700000000000,"x":n:40435303b946e220,"y":n:4035e4190f0db8ad,},{"id":n:40c42f0000000000,"tick":n:40ed396000000000,"day":n:40a37e0000000000,"year":n:407a000000000000,"type":s:"field","txt":s:"🌾 <b>Ask II</b> brings in the harvest from Ask II's field. Winter holds less fear now.","agent":n:4080f00000000000,"x":n:4044000000000000,"y":n:403b000000000000,},{"id":n:40c42f8000000000,"tick":n:40ed3bc000000000,"day":n:40a37e0000000000,"year":n:407a000000000000,"type":s:"taught","txt":s:"<b>Bjorn II</b> taught <b>Sixten II</b> the secret of Ask's lenswork. The knowledge spreads.","tech":s:"glass",},{"id":n:40c4300000000000,"tick":n:40ed3c8000000000,"day":n:40a3800000000000,"year":n:407a000000000000,"type":s:"season","txt":s:"❄️ Winter closes over the world. The stores will decide who sees spring.",},{"id":n:40c4308000000000,"