,"x":n:40401145f5b21996,"y":n:4037e1d72b06bb49,"cause":s:"greed","causes":[s:"ev:3691",s:"agent:213",s:"cause:greed",],},{"id":n:40b07a0000000000,"tick":n:40df8a0000000000,"day":n:4095080000000000,"year":n:406c200000000000,"type":s:"death","txt":s:"<b>Ulv II the Oathbreaker</b> died of old age at 70. Much knowledge died with them — unless someone learned in time.","agent":n:406a000000000000,"x":n:40446d7bfa88a9fa,"y":n:4040cb8dc5fbdf81,"cause":s:"age","causes":[s:"cause:age",],},{"id":n:40b07b0000000000,"tick":n:40df8a0000000000,"day":n:4095080000000000,"year":n:406c200000000000,"type":s:"customLost","txt":s:"🕯️ No one remembers Placing a stone on the grave anymore. A piece of who they were is gone.","custom":s:"c39",},{"id":n:40b07c0000000000,"tick":n:40df8b4000000000,"day":n:40950c0000000000,"year":n:406c200000000000,"type":s:"taught","txt":s:"<b>Ronja II</b> taught <b>Torv II</b> the secret of Ask's the sail. The knowledge spreads.","tech":s:"sailing",},{"id":n:40b07d0000000000,"tick":n:40df8f8000000000,"day":n:40950c0000000000,"year":n:406c200000000000,"type":s:"child","txt":s:"👶 <b>Kare II</b> and <b>Ylva II</b> have had a child, <b>Saga II</b> — generation 11. They inherit traits from both.","agent":n:406f200000000000,"x":n:403fdb824c7a48aa,"y":n:40418fc966707f40,"causes":[s:"agent:222",s:"agent:217",],},{"id":n:40b07e0000000000,"tick":n:40df930000000000,"day":n:4095100000000000,"year":n:406c200000000000,"type":s:"taught","txt":s:"<b>Liv II</b> taught <b>Eira II</b> the secret of Ask's lenswork. The knowledge spreads.","tech":s:"glass",},{"id":n:40b07f0000000000,"tick":n:40df9d0000000000,"day":n:4095180000000000,"year":n:406c200000000000,"type":s:"season","txt":s:"❄️ Winter closes over the world. The stores will decide who sees spring.",},{"id":n:40b0800000000000,"tick":n:40dfa3c000000000,"day":n:40951c0000000000,"year":n:406c200000000000,"type":s:"taught","txt":s:"<b>Ylva II</b> taught <b>Saga II</b> the secret of Embla's the loom. The knowledge spreads.","te