":n:408f280000000000,"tick":n:40cafb0000000000,"day":n:4082000000000000,"year":n:4058000000000000,"type":s:"taught","txt":s:"<b>Maja</b> taught <b>Eira II</b> the secret of Ask's fishing line. The knowledge spreads.","tech":s:"fishing",},{"id":n:408f300000000000,"tick":n:40cafc8000000000,"day":n:4082000000000000,"year":n:4058000000000000,"type":s:"hut","txt":s:"🛖 <b>Ask II</b> built a hut.","x":n:4041f49090e2df75,"y":n:403f9836e46e8c5a,},{"id":n:408f380000000000,"tick":n:40cafd8000000000,"day":n:4082080000000000,"year":n:4058000000000000,"type":s:"raid","txt":s:"⚔️ <b>Loke II</b> set upon <b>Selma</b> and seized goods — the gap was cheaper to close by force.","agent":n:404a000000000000,"victim":n:4039000000000000,"x":n:404dd5ffd6dee408,"y":n:4041331c8acb07e4,"cause":s:"greed","causes":[s:"ev:615",s:"agent:25",s:"cause:greed",],},{"id":n:408f400000000000,"tick":n:40cb000000000000,"day":n:4082080000000000,"year":n:4058400000000000,"type":s:"season","txt":s:"🌸 Spring returns. The survivors count each other, and begin again.",},{"id":n:408f480000000000,"tick":n:40cb000000000000,"day":n:4082080000000000,"year":n:4058400000000000,"type":s:"journey","txt":s:"🚶 <b>Ask II</b> set out for Majaheim. Ideas travel on foot.","agent":n:4040000000000000,"x":n:4041eb4bd0205bc1,"y":n:403fc3d89aa0a46a,},{"id":n:408f500000000000,"tick":n:40cb000000000000,"day":n:4082080000000000,"year":n:4058400000000000,"type":s:"leader","txt":s:"👑 In <b>Runestead</b>, the people have begun to listen when <b>Halvar</b> speaks — prestige has hardened into leadership. No one voted; it is simply so.","village":s:"Runestead","agent":n:402c000000000000,"x":n:403e5a7031830b7a,"y":n:4043b7da751bb8dd,"label":s:"A LEADER IS RECOGNIZED","causes":[s:"agent:14",],},{"id":n:408f580000000000,"tick":n:40cb000000000000,"day":n:4082080000000000,"year":n:4058400000000000,"type":s:"epithet","txt":s:"✨ From that day on, <b>Halvar</b> was known as <b>Halvar the Voice of Runestead</b>.","agent":n:402c000000000000,"x":n:403